@model Project_Sem3.Models.LoanPayment

@{
    ViewData["Title"] = "Edit";
}

@section VendorStyles{
<link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
<link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
<link rel="stylesheet" href="~/vendor/libs/typeahead-js/typeahead.css" />
<link rel="stylesheet" href="~/vendor/libs/tagify/tagify.css" />
<link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />
}

@section VendorScripts{
<script src="~/vendor/libs/select2/select2.js"></script>
<script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
<script src="~/vendor/libs/moment/moment.js"></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="~/vendor/libs/typeahead-js/typeahead.js"></script>
<script src="~/vendor/libs/tagify/tagify.js"></script>
<script src="~/vendor/libs/&#64;form-validation/popular.js"></script>
<script src="~/vendor/libs/&#64;form-validation/bootstrap5.js"></script>
<script src="~/vendor/libs/&#64;form-validation/auto-focus.js"></script>
}

@section PageScripts {
<script src="~/js/form-validation.js"></script>
}

<h1>Edit</h1>

<div class="row">
  <!-- FormValidation -->
  <div class="col-12">
    <div class="card">
      <div class="card-body">

        @* <div id="successAlert" class="alert alert-success"> *@
        @*   <strong>Success!</strong> Payment created successfully. *@
        @* </div> *@
        @* <div id="errorAlert" class="alert alert-danger"> *@
        @*   <strong>Error!</strong> Something went wrong, please try again. *@
        @* </div> *@

        <form id="formValidationExamples" class="row g-6" asp-action="Edit" method="post">
          <div asp-validation-summary="ModelOnly" class="text-danger"></div>
          <input type="hidden" asp-for="Id" id="id" />
          <div class="form-group">
            <label asp-for="BorrowId" class="control-label"></label>
            <select asp-for="BorrowId" id="borrowId" class="form-control" asp-items="ViewBag.BorrowId"></select>
            <span asp-validation-for="BorrowId" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="PaymentAmount" class="control-label"></label>
            <input asp-for="PaymentAmount" id="paymentAmount" class="form-control" />
            <span asp-validation-for="PaymentAmount" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="PaymentDate" class="control-label"></label>
            <input asp-for="PaymentDate" id="paymentDate" class="form-control" />
            <span asp-validation-for="PaymentDate" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="PaymentImage" class="control-label"></label>
            <input asp-for="PaymentImage" id="paymentImage" class="form-control" />
            <span asp-validation-for="PaymentImage" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="OverdueDays" class="control-label"></label>
            <input asp-for="OverdueDays" id="overdueDays" class="form-control" />
            <span asp-validation-for="OverdueDays" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="PenaltyInterest" class="control-label"></label>
            <input asp-for="PenaltyInterest" id="penaltyInterest" class="form-control" />
            <span asp-validation-for="PenaltyInterest" class="text-danger"></span>
          </div>
          <div class="form-group form-check">
            <label class="form-check-label">
              <input class="form-check-input" asp-for="Status" /> @Html.DisplayNameFor(model => model.Status)
            </label>
          </div>
          <div class="col-12">
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="formValidationCheckbox" name="formValidationCheckbox"/>
              <label class="form-check-label" for="formValidationCheckbox">Agree to our terms and conditions</label>
            </div>
          </div>
          <div class="form-group">
            <input type="submit" value="Save" class="btn btn-primary"/>
          </div>
        </form>
      </div>
    </div>
  </div>
  <!-- /FormValidation -->
</div>
<div>
  <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
  $(document).ready(function() {
    // When the form is submitted
    $('#formValidationExamples').on('submit', function(e) {
      e.preventDefault(); // Prevent default form submission

      // Get form data for loan payment
      const loanPaymentData = {
        id: $('#id').val(),  // Get the loan payment ID
        borrowId: $('#borrowId').val(),  // Get the selected BorrowId
        paymentAmount: $('#paymentAmount').val(),  // Get the payment amount
        paymentDate: $('#paymentDate').val(),  // Get the payment date
        paymentImage: $('#paymentImage').val(),  // Get the payment image
        overdueDays: $('#overdueDays').val(),  // Get the overdue days
        penaltyInterest: $('#penaltyInterest').val(),  // Get the penalty interest
        status: $('#status').prop('checked'),  // Get the status (checkbox value)
        agreeToTerms: $('#formValidationCheckbox').prop('checked') // Terms and conditions checkbox value
      };

      // Send AJAX request to update Loan Payment (PUT request)
      $.ajax({
        url: '/api/loan-payment/' + loanPaymentData.id,  // Use loanPaymentData.id to target the specific loan payment
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(loanPaymentData),  // Send the data as JSON
        success: function(response) {
          // Show a success message or take an action on success
          alert("Loan Payment updated successfully!");
          // Optionally, reset the form after a successful update
          $('#formValidationExamples')[0].reset();
        },
        error: function(xhr, status, error) {
          // Show an error message if something goes wrong
          alert("Error updating Loan Payment: " + error);
        }
      });
    });
  });
</script>
}
