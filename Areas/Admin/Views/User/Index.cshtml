@model IEnumerable<Project_Sem3.Models.User>

@{
    ViewData["Title"] = "Index";
}

@section VendorStyles {
<!-- Add any vendor stylesheets you might still need -->
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
}

@section VendorScripts {
<!-- Add any scripts you need for this page -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

<p>
    <a asp-action="Create">Create New</a>
</p>
<!-- Table to show users -->
<div class="card">
  <h5 class="card-header">User List</h5>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-bordered">
        <thead>
        <tr>
          <th>Id</th>
          <th>Full Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Gender</th>
          <th>Citizen Identification Card</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
          <tr>
            <td>@user.Id</td>
            <td>@user.FullName</td>
            <td>@user.Email</td>
            <td>@user.Phone</td>
            <td>@user.Gender</td>
            <td>@user.CitizenIdentificationCard</td>
            <td>@user.Status</td>
            <td>
              <a href="@Url.Action("Details", "User", new { id = user.Id })" class="btn btn-info btn-sm">View</a>
              <a href="@Url.Action("Edit", "User", new { id = user.Id })" class="btn btn-primary btn-sm">Edit</a>
              <a href="@Url.Action("Delete", "User", new { id = user.Id })" class="btn btn-danger btn-sm">Delete</a>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div>
