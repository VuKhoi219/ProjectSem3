@model Project_Sem3.Models.InsuranceContract

@{
    ViewData["Title"] = "Edit";
}

@section VendorStyles{
<link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
<link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
<link rel="stylesheet" href="~/vendor/libs/typeahead-js/typeahead.css" />
<link rel="stylesheet" href="~/vendor/libs/tagify/tagify.css" />
<link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />
}

@section VendorScripts{
<script src="~/vendor/libs/select2/select2.js"></script>
<script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
<script src="~/vendor/libs/moment/moment.js"></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="~/vendor/libs/typeahead-js/typeahead.js"></script>
<script src="~/vendor/libs/tagify/tagify.js"></script>
<script src="~/vendor/libs/&#64;form-validation/popular.js"></script>
<script src="~/vendor/libs/&#64;form-validation/bootstrap5.js"></script>
<script src="~/vendor/libs/&#64;form-validation/auto-focus.js"></script>
}

@section PageScripts {
<script src="~/js/form-validation.js"></script>
}

<h1>Edit</h1>

<div class="row">
  <!-- FormValidation -->
  <div class="col-12">
    <div class="card">
      <div class="card-body">

        @* <div id="successAlert" class="alert alert-success"> *@
        @*   <strong>Success!</strong> Payment created successfully. *@
        @* </div> *@
        @* <div id="errorAlert" class="alert alert-danger"> *@
        @*   <strong>Error!</strong> Something went wrong, please try again. *@
        @* </div> *@

        <form id="formValidationExamples" class="row g-6" asp-action="Edit" method="post">
          <div asp-validation-summary="ModelOnly" class="text-danger"></div>
          <input type="hidden" asp-for="Id" id="id" />
          <div class="form-group">
            <label asp-for="UserId" class="control-label"></label>
            <input asp-for="UserId" id="userId" class="form-control"/>
            <span asp-validation-for="UserId" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="PlanId" class="control-label"></label>
            <select asp-for="PlanId" id="planId" class="form-control" asp-items="ViewBag.PlanId"></select>
            <span asp-validation-for="PlanId" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="DetailId" class="control-label"></label>
            <input asp-for="DetailId" id="detailId" class="form-control" />
            <span asp-validation-for="DetailId" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="StartDate" class="control-label"></label>
            <input asp-for="StartDate" type="date" id="startDate" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="EndDate" class="control-label"></label>
            <input asp-for="EndDate" type="date" id="endDate" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label asp-for="CreatedBy" class="control-label"></label>
            <select asp-for="CreatedBy" id="createdBy" class="form-control" asp-items="ViewBag.CreatedBy"></select>
            <span asp-validation-for="CreatedBy" class="text-danger"></span>
          </div>
          <div class="col-12">
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="formValidationCheckbox" name="formValidationCheckbox"/>
              <label class="form-check-label" for="formValidationCheckbox">Agree to our terms and conditions</label>
            </div>
          </div>
          <div class="form-group">
            <input type="submit" value="Save" class="btn btn-primary"/>
          </div>
        </form>
      </div>
    </div>
  </div>
  <!-- /FormValidation -->
</div>
<div>
  <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
  $(document).ready(function() {
    // When the form is submitted
    $('#formValidationExamples').on('submit', function(e) {
      e.preventDefault(); // Prevent the default form submission

      // Get form data for insurance contract
      const insuranceContractData = {
        id: $('#id').val(),  // Get the insurance contract ID
        userId: $('#userId').val(),  // Get the selected UserId
        planId: $('#planId').val(),  // Get the selected PlanId
        detailId: $('#detailId').val(),  // Get the DetailId
        startDate: $('#startDate').val(),  // Get the StartDate
        endDate: $('#endDate').val(),  // Get the EndDate
        createdBy: $('#createdBy').val(),  // Get the CreatedBy
        agreeToTerms: $('#formValidationCheckbox').prop('checked')  // Terms and conditions checkbox value
      };

      // Send AJAX request to update Insurance Contract (PUT request)
      $.ajax({
        url: '/api/insurance-contracts/' + insuranceContractData.id,  // Use insuranceContractData.id to target the specific insurance contract
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(insuranceContractData),  // Send the data as JSON
        success: function(response) {
          // Show a success message or take an action on success
          alert("Insurance Contract updated successfully!");
          // Optionally, reset the form after a successful update
          $('#formValidationExamples')[0].reset();
        },
        error: function(xhr, status, error) {
          // Show an error message if something goes wrong
          alert("Error updating Insurance Contract: " + error);
        }
      });
    });
  });
</script>
}


