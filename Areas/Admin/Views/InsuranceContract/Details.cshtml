        toEmail = data.user.email
        if (data) {
          // Xác định chi tiết hợp đồng dựa trên loại bảo hiểmvar detailHtml = '';
          if (data.insurancePlan.lifeDetail) {
            detailHtml = `
                <div class="sub-section">
                    <h5>Life Insurance Details</h5>
                    <dt class="col-sm-3">Term Years</dt>
                    <dd class="col-sm-9">${data.insurancePlan.lifeDetail.termYears || 'N/A'} years</dd>
                    <dt class="col-sm-3">Age Group</dt>
                    <dd class="col-sm-9">${data.insurancePlan.lifeDetail.ageGroup || 'N/A'}</dd>
                    <dt class="col-sm-3">Beneficiaries</dt>
                    <dd class="col-sm-9">${data.insurancePlan.lifeDetail.beneficiaries || 'N/A'}</dd>
                    <dt class="col-sm-3">Premium</dt>
                    <dd class="col-sm-9">${data.insurancePlan.lifeDetail.premium?.toLocaleString() || 'N/A'} VND</dd>
                    <dt class="col-sm-3">Deductible</dt>
                    <dd class="col-sm-9">${data.insurancePlan.lifeDetail.deductible?.toLocaleString() || 'N/A'} VND</dd>
                    <dt class="col-sm-3">Duration</dt>
                    <dd class="col-sm-9">${data.insurancePlan.lifeDetail.duration || 'N/A'} months</dd>
                    <dt class="col-sm-3">Risk Factor</dt>
                    <dd class="col-sm-9">${(data.insurancePlan.lifeDetail.riskFactor * 100).toFixed(2) || 'N/A'}%</dd>
                    <dt class="col-sm-3">Region</dt>
                    <dd class="col-sm-9">${data.insurancePlan.lifeDetail.region || 'N/A'}</dd>
