        <td style="padding: 10px; font-weight: bold; border-bottom: 1px solid #ddd;">Premium</td>
        <td style="padding: 10px; border-bottom: 1px solid #ddd;">${contractData.insurancePlan.propertyDetail.premium?.toLocaleString() || 'N/A'} VND</td>
      </tr>
      <tr>
        <td style="padding: 10px; font-weight: bold; border-bottom: 1px solid #ddd;">Deductible</td>
        <td style="padding: 10px; border-bottom: 1px solid #ddd;">${contractData.insurancePlan.propertyDetail.deductible?.toLocaleString() || 'N/A'} VND</td>
      </tr>
      <tr style="background-color: #ecf0f1;">
        <td style="padding: 10px; font-weight: bold; border-bottom: 1px solid #ddd;">Duration</td>
        <td style="padding: 10px; border-bottom: 1px solid #ddd;">${contractData.insurancePlan.propertyDetail.duration || 'N/A'} months</td>
      </tr>
      <tr>
        <td style="padding: 10px; font-weight: bold; border-bottom: 1px solid #ddd;">Risk Factor</td>
        <td style="padding: 10px; border-bottom: 1px solid #ddd;">${(contractData.insurancePlan.propertyDetail.riskFactor * 100).toFixed(2) || 'N/A'}%</td>
      </tr>
      <tr style="background-color: #ecf0f1;">
        <td style="padding: 10px; font-weight: bold; border-bottom: 1px solid #ddd;">Region</td>
        <td style="padding: 10px; border-bottom: 1px solid #ddd;">${contractData.insurancePlan.propertyDetail.region || 'N/A'}</td>
      </tr>
    `;
    } else {
      emailBody += `
      <tr>
        <td style="padding: 10px; font-weight: bold; border-bottom: 1px solid #ddd;">Details</td>
        <td style="padding: 10px; border-bottom: 1px solid #ddd;">No additional details available</td>
      </tr>
    `;
    }

    emailBody += `
      </table>
      <p style="text-align: center; color: #7f8c8d; margin-top: 20px; font-size: 12px;">This is an automatically generated email. Please do not reply directly to this message.</p>
      <p>Please go to the address <span style="color: #0000FF;"> 8A Ton That Thuyet, My Dinh 2, Cau Giay, Ha Noi </span> to receive support from staff</p>
    </div>
  `;

    // Dữ liệu gửi tới API
    var data = {
      To: toEmail,
      Subject: "Your Insurance Contract Details",
      Body: emailBody
    };

    // Gửi yêu cầu AJAX để gửi email
    $.ajax({
      url: `/api/send-email/send`,
      method: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(data),
      success: function (response) {
        alert("Email đã được gửi thành công!");
      },
      error: function (xhr, status, error) {
        alert(`Lỗi khi gửi email: ${error}`);
      }
    });
  }
</script>
}

<!-- Main content -->
<div class="container mt-4">
  <h1 class="mb-4">Insurance Contract Details</h1>
  <div>
    <button type="button" class="btn btn-light" onclick="SendEmail()">Send email<i class='bx bx-mail-send'></i></button>
  </div>
  <!-- Div để hiển thị chi tiết hợp đồng -->
  <div id="insuranceContractDetails">
    <p class="loading-text">Loading contract details...</p>
  </div>

  <!-- Action links -->
  <div class="action-links mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
  </div>
</div>
