@model IEnumerable<Project_Sem3.Models.InsuranceContract>

@{
    ViewData["Title"] = "Index";
}

@section VendorStyles {
<!-- Add any vendor stylesheets you might still need -->
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
}

@section VendorScripts {
<!-- Add any scripts you need for this page -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

<p>
  <a asp-action="Create">Create New</a>
</p>
<!-- Table to show users -->
<div class="card">
  <h5 class="card-header">Insurance Contract List</h5>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-bordered">
        <thead>
        <tr>
          <th>Id</th>
          <th>User</th>
          <th>Plan</th>
          <th>Detail Id</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var contract in Model)
        {
        <tr>
          <td>@contract.Id</td>
          <td>@contract.User.FullName</td>
          <td>@contract.Plan.Name</td>
          <td>@contract.DetailId</td>
          <td>@contract.StartDate</td>
          <td>@contract.EndDate</td>
          <td>
            <a href="@Url.Action("Details", "InsuranceContract", new { id = contract.Id })" class="btn btn-info btn-sm">View</a>
            <a href="@Url.Action("Edit", "InsuranceContract", new { id = contract.Id })" class="btn btn-primary btn-sm">Edit</a>
            <a href="@Url.Action("Delete", "InsuranceContract", new { id = contract.Id })" class="btn btn-danger btn-sm">Delete</a>
          </td>
        </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div>


<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DetailId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeleteAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Creator)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Updater)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deleter)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Plan)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DetailId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeleteAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.CitizenIdentificationCard)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Creator.CitizenIdentificationCard)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Updater.CitizenIdentificationCard)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Deleter.CitizenIdentificationCard)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Plan.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
