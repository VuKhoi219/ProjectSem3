@model IEnumerable<Project_Sem3.Models.InsuranceContract>

@{
ViewData["Title"] = "Insurance Contracts List";
}

@section VendorStyles {
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}

@section VendorScripts {
<script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<script src="~/vendor/libs/moment/moment.js"></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

@section Scripts {
  <script>
  var dataTable = $('#dataTable').DataTable({
    processing: true,
    serverSide: true,
    ajax: {
      url: '/api/insurance-contracts',  // API URL for fetching insurance contracts
      type: 'GET',
      data: function (d) {
        d.page = (d.start / d.length) + 1;
        d.pageSize = d.length;
        d.search = d.search.value;
        d.orderColumn = d.columns[d.order[0].column].data;
        d.orderDir = d.order[0].dir;

        // Add custom filter data
        d.userName = $('#filterUserName').val();  // Filter by User Name
        d.planName = $('#filterPlanName').val();  // Filter by Plan Name
        d.status = $('#filterStatus').val();      // Filter by Status
        d.startDate = $('#filterStartDate').val(); // Filter by Start Date
        d.endDate = $('#filterEndDate').val();    // Filter by End Date
        d.daysToExpire = $('#daysToExpire').val();

        return d;
      },
      dataSrc: 'data',
    },
    columns: [
      { data: 'id' },
      { data: 'fullName' },
      { data: 'planName' },
      { data: 'status', render: function (data) {
          return data == 1 ? 'Active' : (data == 0 ? 'Inactive' : 'Expired');
        }},
      { data: 'startDate' },
      { data: 'endDate' },
      {
        data: null,
        orderable: false,
        searchable: false,
        render: function (data, type, row) {
          return '<button class="btn btn-sm btn-primary btn-edit" data-id="' + row.id + '">Edit</button> ' +
            '<button class="btn btn-sm btn-danger btn-delete" data-id="' + row.id + '">Delete</button> ' +
            '<button class="btn btn-sm btn-info btn-detail" data-id="' + row.id + '">View</button>';
        }
      }
    ]
  });

  // Refresh the DataTable when filters change
  $('#filterUserName, #filterPlanName, #filterStatus, #filterStartDate, #filterEndDate, #filterDayToExpired').on('change', function() {
    dataTable.draw();
  });

  // Date picker for Start and End Date filters
  flatpickr('#filterStartDate', {
    dateFormat: 'Y-m-d'
  });

  flatpickr('#filterEndDate', {
    dateFormat: 'Y-m-d'
  });

  dataTable.on('click', '.btn-edit', function () {
    var contractId = $(this).data('id');
    window.location.href = '/Admin/InsuranceContract/Edit/' + contractId;
  });

  dataTable.on('click', '.btn-delete', function () {
    var contractId = $(this).data('id');
    window.location.href = '/Admin/InsuranceContract/Delete/' + contractId;
  });

  dataTable.on('click', '.btn-detail', function () {
    var contractId = $(this).data('id');
    var rowData = dataTable.row($(this).parents('tr')).data();

    var planId = rowData.planId;
    var userId = rowData.userId;

    if (!contractId || !planId || !userId) {
      console.error('Missing required data:', { contractId, planId, userId });
      alert('Không thể tải chi tiết hợp đồng do thiếu dữ liệu.');
      return;
    }

    console.log('Contract ID:', contractId);
    console.log('Plan ID:', planId);
    console.log('User ID:', userId);

    sessionStorage.setItem('contractId', contractId);
    sessionStorage.setItem('planId', planId);
    sessionStorage.setItem('userId', userId);

    window.location.href = '/Admin/InsuranceContract/Details/' + contractId;
  });
</script>
}

<!-- Advanced Search -->
<div class="card">
  <h5 class="card-header d-flex justify-content-between">Insurance Contracts List
    <a href="@Url.Action("Create", "InsuranceContract")" class="float-right btn btn-primary">Create New Contract</a>
  </h5>

  <!-- Filter Section -->
  <div class="card-body">
    <div class="row">
      <div class="col-md-3">
        <input type="text" id="filterUserName" class="form-control" placeholder="Search by User Name">
      </div>
      <div class="col-md-3">
        <input type="text" id="filterPlanName" class="form-control" placeholder="Search by Plan Name">
      </div>
      <div class="col-md-2">
        <select id="filterStatus" class="form-control">
          <option value="">Select Status</option>
          <option value="1">Active</option>
          <option value="0">Inactive</option>
          <option value="2">Expired</option>
        </select>
      </div>
      <div class="col-md-2">
        <input type="text" id="filterStartDate" class="form-control" placeholder="Start Date" />
      </div>
      <div class="col-md-2">
        <input type="text" id="filterEndDate" class="form-control" placeholder="End Date" />
      </div>
      <div class="col-md-3 pt-4">
        <input type="number" class="form-control" id="filterDayToExpired" placeholder="Enter number of days before expired" />
      </div>
    </div>
  </div>

  <div class="card-datatable table-responsive">
    <table id="dataTable" class="dt-advanced-search table border-top">
      <thead>
      <tr>
        <th>Id</th>
        <th>User Name</th>
        <th>Plan Name</th>
        <th>Status</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Action</th>
      </tr>
      </thead>
    </table>
  </div>
</div>
<!-- /Advanced Search -->
