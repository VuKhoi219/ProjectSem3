@model IEnumerable<Project_Sem3.Models.InsurancePropertyDetail>

@{
    ViewData["Title"] = "Insurance Property Details";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/vendor/libs/moment/moment.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

@section Scripts {
    <script>
        var dataTable = $('#dataTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/api/insurance-property',  // Adjust URL to the correct API endpoint for insurance property details
                type: 'GET',
                data: function (d) {
                    d.page = (d.start / d.length) + 1;
                    d.pageSize = d.length;
                    d.search = d.search.value;
                    d.orderColumn = d.columns[d.order[0].column].data;
                    d.orderDir = d.order[0].dir;
                    return d;
                },
                dataSrc: 'data',
            },
            columns: [
                { data: 'id' },
                { data: 'propertyType' },
                { data: 'location' },
                { data: 'duration' },
                { data: 'riskFactor' },
                { data: 'region' },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (data, type, row) {
                        return '<button class="btn btn-sm btn-primary btn-edit" data-id="' + row.id + '">Edit</button> ' +
                            '<button class="btn btn-sm btn-danger btn-delete" data-id="' + row.id + '">Delete</button> ' +
                            '<button class="btn btn-sm btn-info btn-detail" data-id="' + row.id + '">View</button>';
                    }
                }
            ]
        });

        dataTable.on('click', '.btn-edit', function () {
            var insurancePropertyDetailId = $(this).data('id');
            window.location.href = '/Admin/InsurancePropertyDetail/Edit/' + insurancePropertyDetailId;
        });

        dataTable.on('click', '.btn-delete', function () {
            var insurancePropertyDetailId = $(this).data('id');
            window.location.href = '/Admin/InsurancePropertyDetail/Delete/' + insurancePropertyDetailId;
        });

        dataTable.on('click', '.btn-detail', function () {
            var insurancePropertyDetailId = $(this).data('id');
            window.location.href = '/Admin/InsurancePropertyDetail/Details/' + insurancePropertyDetailId;  // Adjust to the view URL
        });
    </script>
}

<!-- Advanced Search -->
<div class="card">
    <h5 class="card-header d-flex justify-content-between">Insurance Property Details</h5>
    <div class="card-datatable table-responsive">
        <table id="dataTable" class="dt-advanced-search table border-top">
            <thead>
            <tr>
                <th>Id</th>
                <th>Property Type</th>
                <th>Location</th>
                <th>Duration</th>
                <th>Risk Factor</th>
                <th>Region</th>
                <th>Action</th>
            </tr>
            </thead>
        </table>
    </div>
</div>
<!-- /Advanced Search -->
