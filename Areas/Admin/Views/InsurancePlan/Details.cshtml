@model Project_Sem3.Models.InsurancePlan

@{
ViewData["Title"] = "Insurance Plan Details";
}

@section VendorStyles {
<!-- Add any vendor stylesheets you might still need -->
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
}

@section VendorScripts {
<!-- Add any scripts you need for this page -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
  $(document).ready(function() {
    // When the "View Insurance Plan Details" button is clicked
    $('#viewInsurancePlanDetailsButton').on('click', function(e) {
      e.preventDefault(); // Prevent default action

      const insurancePlanId = $(this).data('insurance-plan-id'); // Get the ID of the insurance plan

      // Send an AJAX request to fetch the insurance plan details
      $.ajax({
        url: '/api/insurance-plans/' + insurancePlanId,  // API route to fetch insurance plan details
        method: 'GET',
        success: function(response) {
          // Check if the response contains the expected data
          if (response && response.id) {
            // Insert the insurance plan details into the HTML
            $('#insurancePlanDetails').html(`
                  <h4>Insurance Plan Details</h4>
                  <hr />
                  <dl class="row">
                    <dt class="col-sm-2">Insurance Plan ID</dt>
                    <dd class="col-sm-10">${response?.id}</dd>
                    <dt class="col-sm-2">Name</dt>
                    <dd class="col-sm-10">${response?.name}</dd>
                    <dt class="col-sm-2">Description</dt>
                    <dd class="col-sm-10">${response?.description}</dd>
                    <dt class="col-sm-2">Type</dt>
                    <dd class="col-sm-10">${response?.type}</dd>
                    <dt class="col-sm-2">Coverage Amount</dt>
                    <dd class="col-sm-10">${response?.coverageAmount}</dd>
                    <dt class="col-sm-2">Created By</dt>
                    <dd class="col-sm-10">${response?.createdBy}</dd>
                    <dt class="col-sm-2">Terms Agreement</dt>
                    <dd class="col-sm-10">${response?.termsAgreed ? 'Agreed' : 'Not Agreed'}</dd>
                  </dl>
                `);
          } else {
            // Handle the case where the response does not contain the expected data
            console.error('Invalid response data:', response);
            alert('Failed to load insurance plan details.');
          }
        },
        error: function(xhr, status, error) {
          // Handle any errors that occur during the AJAX request
          console.error('AJAX request error:', error);
          alert('An error occurred while fetching insurance plan details.');
        }
      });
    });
  });
</script>
}

<h1>Insurance Plan Details</h1>

<!-- Button to view insurance plan details -->
<div>
  <button id="viewInsurancePlanDetailsButton" data-insurance-plan-id="@Model?.Id" class="btn btn-primary">View Insurance Plan Details</button>
</div>

<!-- Div to display the details dynamically -->
<div id="insurancePlanDetails">
  <!-- Insurance plan details will be loaded here dynamically -->
</div>

<div>
  <a asp-action="Edit" class="col-md-6" asp-route-id="@Model?.Id">Edit</a> |
  <a asp-action="Index" class="col-md-6">Back to List</a>
</div>
