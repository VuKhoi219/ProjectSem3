@model Project_Sem3.Models.InsurancePlan

@{
ViewData["Title"] = "Insurance Plan Details";
}

@section VendorStyles {
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
  .card {
    border-radius: 12px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in-out;
  }

  .card:hover {
    transform: translateY(-5px);
  }

  .card-header {
    background: linear-gradient(135deg, #007bff, #6610f2);
    color: #fff;
    font-weight: bold;
  }

  .details-icon {
    font-size: 1.2rem;
    color: #007bff;
    margin-right: 8px;
  }
</style>
}

@section VendorScripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
  var planId;
  $(document).ready(function () {
    planId = sessionStorage.getItem('planId');

    if (!planId) {
      $('#insurancePlanDetails').html(`
                    <div class="alert alert-warning text-center">
                        <i class="fas fa-exclamation-triangle"></i> No insurance plan found.
                    </div>
                `);
      return;
    }

    $.ajax({
      url: '/api/insurance-plans/' + planId,
      method: 'GET',
      success: function (response) {
        if (response && response.data) {
          $('#insurancePlanDetails').html(`
                            <div class="card">
                                <div class="card-header">
                                    <i class="fas fa-file-contract"></i> Insurance Plan Details
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item">
                                            <i class="fas fa-id-badge details-icon"></i>
                                            <strong>Insurance Plan ID:</strong> ${response?.data.id}
                                        </li>
                                        <li class="list-group-item">
                                            <i class="fas fa-user-shield details-icon"></i>
                                            <strong>Name:</strong> ${response?.data.name}
                                        </li>
                                        <li class="list-group-item">
                                            <i class="fas fa-file-alt details-icon"></i>
                                            <strong>Description:</strong> ${response?.data.description}
                                        </li>
                                        <li class="list-group-item">
                                            <i class="fas fa-list details-icon"></i>
                                            <strong>Type:</strong> ${response?.data.type}
                                        </li>
                                        <li class="list-group-item">
                                            <i class="fas fa-dollar-sign details-icon"></i>
                                            <strong>Coverage Amount:</strong> $${response?.data.coverageAmount.toLocaleString()}
                                        </li>
                                        <li class="list-group-item">
                                            <i class="${response?.data.termsAgreed ? 'fas fa-check-circle text-success' : 'fas fa-times-circle text-danger'} details-icon"></i>
                                            <strong>Terms Agreement:</strong> ${response?.data.termsAgreed ? 'Agreed' : 'Not Agreed'}
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        `);
        } else {
          $('#insurancePlanDetails').html(`
                            <div class="alert alert-danger text-center">
                                <i class="fas fa-times-circle"></i> Failed to load insurance plan details.
                            </div>
                        `);
        }
      },
      error: function () {
        $('#insurancePlanDetails').html(`
                        <div class="alert alert-danger text-center">
                            <i class="fas fa-exclamation-triangle"></i> An error occurred while fetching insurance plan details.
                        </div>
                    `);
      }
    });
  });
  function edit() {
    planId = sessionStorage.getItem('planId');
    window.location.href = '/Admin/InsurancePlan/Edit/' + planId;
  }

</script>
}

<h1 class="text-center mt-3">
  <i class="fas fa-file-medical"></i> Insurance Plan Details
</h1>

<!-- Div to display the details dynamically -->
<div id="insurancePlanDetails" class="container mt-4"></div>

<!-- Navigation Buttons -->
<div class="text-center mt-3">
  <button onclick="edit()" class="btn btn-primary">Edit</button>
  <a asp-action="Index" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Back to List
  </a>
</div>
