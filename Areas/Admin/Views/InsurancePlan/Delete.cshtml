@model Project_Sem3.Models.InsurancePlan

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>InsurancePlan</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Type)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CoverageAmount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CoverageAmount)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Creator)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Creator.CitizenIdentificationCard)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

@section Scripts {
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script>
    $(document).ready(function() {
      // Handle delete action when delete button is clicked
      $('.deleteInsurancePlanButton').on('click', function(e) {
        e.preventDefault(); // Prevent the default action

        // Get the ID of the insurance plan (assuming it's stored in a data attribute of the button)
        const insurancePlanId = $(this).data('insurance-plan-id');

        // Confirm the action with the user before proceeding
        if (!confirm('Are you sure you want to delete this insurance plan?')) {
          return; // If the user cancels, stop the process
        }

        // Send an AJAX request to delete the insurance plan
        $.ajax({
          url: '/api/insurance-plans' + insurancePlanId,  // Assuming the route for deleting an insurance plan is '/InsurancePlan/Delete/{id}'
          method: 'DELETE',
          success: function(response) {
            // Show success alert and hide error alert
            $('#successAlert').show();
            $('#errorAlert').hide();

            // Optionally, remove the insurance plan row from the DOM
            $('#insurancePlanRow_' + insurancePlanId).remove();
          },
          error: function(xhr, status, error) {
            // Show error alert and hide success alert
            $('#errorAlert').show();
            $('#successAlert').hide();
          }
        });
      });
    });
  </script>
}
