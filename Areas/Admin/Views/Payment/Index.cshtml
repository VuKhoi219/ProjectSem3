@model IEnumerable<Project_Sem3.Models.Payment>

@{
ViewData["Title"] = "Index";
}

@section VendorStyles {
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}

@section VendorScripts {
<script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<!-- Flat Picker -->
<script src="~/vendor/libs/moment/moment.js"></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

<!-- Advanced Search -->
<div class="card">
  <h5 class="card-header d-flex justify-content-between">Payment List
    <a href="@Url.Action("Create", "Payment")" class="float-right btn btn-primary">Create New Payment</a></h5>
  <div class="card-datatable table-responsive">
    <table id="dataTable" class="dt-advanced-search table border-top">
      <thead>
      <tr>
        <th><input type="checkbox" id="select-all" /></th> <!-- Checkbox for selecting all -->
        <th>Id</th>
        <th>User</th>
        <th>Contract</th>
        <th>Amount</th>
        <th>Image Url</th>
        <th>Action</th>
      </tr>
      </thead>
    </table>
  </div>
</div>
<!-- /Advanced Search -->

@section Scripts {
<script>
  var dataTable = $('#dataTable').DataTable({
    processing: true,
    serverSide: true,
    ajax: {
      url: '/api/payments', // Update this to your API endpoint for payments
      type: 'GET',
      data: function (d) {
        // Sending additional parameters to the server for pagination and sorting
        d.page = (d.start / d.length) + 1;
        d.pageSize = d.length;
        d.search = d.search.value;
        d.orderColumn = d.columns[d.order[0].column].data;
        d.orderDir = d.order[0].dir;
        return d;
      },
      success: function (response) {
        if (response && response.data) {
          // Success: The server returned the data, now populate the DataTable
          dataTable.clear();
          dataTable.rows.add(response.data);
          dataTable.draw();
        } else {
          // If no data is available
          Swal.fire({
            icon: 'warning',
            title: 'No Data Available',
            text: 'No payments found matching the search criteria.',
          });
        }
      },
      error: function (xhr, status, error) {
        // Error handling
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: 'Something went wrong while loading the payments.',
        });
      }
    },
    columns: [
      {
        data: null,
        render: function (data, type, row, meta) {
          return '<input type="checkbox" class="select-row" />';
        },
        orderable: false
      },
      { data: 'id' },
      { data: 'userId' },
      { data: 'contractId' },
      {
        data: 'amount',
        render: function (data) {
          return data.toLocaleString();
        }
      },
      { data: 'imageUrl' },
      {
        data: null,
        render: function (data) {
          return `
                            <button class="btn btn-warning btn-sm" onclick="editPayment(${data.id})">Edit</button>
                            <button class="btn btn-danger btn-sm" onclick="deletePayment(${data.id})">Delete</button>
                        `;
        }
      }
    ],
    initComplete: function () {
      // Checkbox select-all functionality
      $('#select-all').on('click', function () {
        var rows = dataTable.rows({ 'search': 'applied' }).nodes(); // Get visible rows after search/filtering
        $('input[type="checkbox"]', rows).prop('checked', this.checked);
      });
    }
  });

  function editPayment(paymentId) {
    // Navigate to the edit page or handle the editing logic
    window.location.href = '/Payment/Edit/' + paymentId;
  }

  function deletePayment(paymentId) {
    // Perform the deletion via an API or show a confirmation
    Swal.fire({
      title: 'Are you sure?',
      text: 'This action cannot be undone.',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Yes, delete it!',
      cancelButtonText: 'No, keep it'
    }).then((result) => {
      if (result.isConfirmed) {
        $.ajax({
          url: '/api/payments/' + paymentId, // Adjust the API endpoint
          type: 'DELETE',
          success: function (response) {
            if (response.success) {
              Swal.fire('Deleted!', 'The payment has been deleted.', 'success');
              dataTable.ajax.reload();  // Reload the DataTable after deletion
            } else {
              Swal.fire('Error!', 'Could not delete the payment. Please try again.', 'error');
            }
          },
          error: function () {
            Swal.fire('Error!', 'Something went wrong. Please try again.', 'error');
          }
        });
      }
    });
  }
</script>
}

