@model IEnumerable<Project_Sem3.Models.Payment>

@{
ViewData["Title"] = "Index";
}

@section VendorStyles {
<!-- Add any vendor stylesheets you might still need -->
<link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
<link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
}

@section VendorScripts {
<!-- Add any scripts you need for this page -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

<p>
  <a asp-action="Create">Create New</a>
</p>
<!-- Table to show users -->
<div class="card">
  <h5 class="card-header">Payment List</h5>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-bordered">
        <thead>
        <tr>
          <th>Id</th>
          <th>User</th>
          <th>Contract</th>
          <th>Amount</th>
          <th>Image Url</th>
          <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var payment in Model)
        {
        <tr>
          <td>@payment.Id</td>
          <td>@payment.User.FullName</td>
          <td>@payment.ContractId</td>
          <td>@payment.Amount</td>
          <td>@payment.ImageUrl</td>
          <td>
            <a href="@Url.Action("Details", "Payment", new { id = payment.Id })" class="btn btn-info btn-sm">View</a>
            <a href="@Url.Action("Edit", "Payment", new { id = payment.Id })" class="btn btn-primary btn-sm">Edit</a>
            <a href="@Url.Action("Delete", "Payment", new { id = payment.Id })" class="btn btn-danger btn-sm">Delete</a>
          </td>
        </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div>
