@model Project_Sem3.Models.InsuranceHealthDetail

@{
ViewData["Title"] = "Edit";
}

@section VendorStyles {
<link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
<link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
<link rel="stylesheet" href="~/vendor/libs/typeahead-js/typeahead.css" />
<link rel="stylesheet" href="~/vendor/libs/tagify/tagify.css" />
<link rel="stylesheet" href="~/vendor/libs/form-validation/form-validation.css" />
}

@section VendorScripts {
<script src="~/vendor/libs/select2/select2.js"></script>
<script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
<script src="~/vendor/libs/moment/moment.js"></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
<script src="~/vendor/libs/typeahead-js/typeahead.js"></script>
<script src="~/vendor/libs/tagify/tagify.js"></script>
<script src="~/vendor/libs/form-validation/popular.js"></script>
<script src="~/vendor/libs/form-validation/bootstrap5.js"></script>
<script src="~/vendor/libs/form-validation/auto-focus.js"></script>
}

@section PageScripts {
<script src="~/js/form-validation.js"></script>
}

<h1>Edit</h1>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <form id="editInsuranceHealthDetailForm" class="row g-6" method="post" asp-action="Edit">
          <div asp-validation-summary="ModelOnly" class="text-danger"></div>
          <input type="hidden" asp-for="Id" id="insuranceHealthDetailId" />

          <div class="form-group">
            <label asp-for="AgeGroup" class="control-label"></label>
            <input asp-for="AgeGroup" class="form-control" id="ageGroup" />
            <span asp-validation-for="AgeGroup" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="HospitalNetwork" class="control-label"></label>
            <input asp-for="HospitalNetwork" class="form-control" id="hospitalNetwork" />
            <span asp-validation-for="HospitalNetwork" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="PreExistingConditions" class="control-label"></label>
            <input asp-for="PreExistingConditions" class="form-control" id="preExistingConditions" />
            <span asp-validation-for="PreExistingConditions" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="Duration" class="control-label"></label>
            <input asp-for="Duration" class="form-control" id="duration" type="number" />
            <span asp-validation-for="Duration" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="RiskFactor" class="control-label"></label>
            <input asp-for="RiskFactor" class="form-control" id="riskFactor" type="number" step="0.01" />
            <span asp-validation-for="RiskFactor" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="Region" class="control-label"></label>
            <input asp-for="Region" class="form-control" id="region" />
            <span asp-validation-for="Region" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="PlanId" class="control-label"></label>
            <select asp-for="PlanId" class="form-control" id="planId" asp-items="ViewBag.PlanId"></select>
            <span asp-validation-for="PlanId" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="AnnualPaymentAmount" class="control-label"></label>
            <input asp-for="AnnualPaymentAmount" class="form-control" id="annualPaymentAmount" type="number" step="0.01" />
            <span asp-validation-for="AnnualPaymentAmount" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="Premium" class="control-label"></label>
            <input asp-for="Premium" class="form-control" id="premium" type="number" step="0.01" />
            <span asp-validation-for="Premium" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="Deductible" class="control-label"></label>
            <input asp-for="Deductible" class="form-control" id="deductible" type="number" step="0.01" />
            <span asp-validation-for="Deductible" class="text-danger"></span>
          </div>

          <div class="col-12">
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="insuranceHealthDetailTerms" name="insuranceHealthDetailTerms" />
              <label class="form-check-label" for="insuranceHealthDetailTerms"> Agree to our terms and conditions</label>
            </div>
          </div>

          <div class="form-group">
            <input type="submit" value="Save" class="btn btn-primary" />
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<div>
  <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
  $(document).ready(function () {
    $('#planId').select2({
      placeholder: "Select an Insurance Plan",
      allowClear: true
    });

    $('#editInsuranceHealthDetailForm').on('submit', function (e) {
      e.preventDefault();

      const insuranceHealthDetailData = {
        id: $('#insuranceHealthDetailId').val(),
        ageGroup: $('#ageGroup').val(),
        hospitalNetwork: $('#hospitalNetwork').val(),
        preExistingConditions: $('#preExistingConditions').val(),
        duration: $('#duration').val(),
        riskFactor: $('#riskFactor').val(),
        region: $('#region').val(),
        planId: $('#planId').val(),
        annualPaymentAmount: $('#annualPaymentAmount').val(),
        premium: $('#premium').val(),
        deductible: $('#deductible').val(),
        termsAgreed: $('#insuranceHealthDetailTerms').prop('checked')
      };

      if (!insuranceHealthDetailData.termsAgreed) {
        alert("You must agree to the terms and conditions.");
        return;
      }

      $.ajax({
        url: '/Admin/InsuranceHealthDetail/Edit/' + insuranceHealthDetailData.id,
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(insuranceHealthDetailData),
        success: function (response) {
          alert("Insurance Health Detail updated successfully!");
          window.location.href = '/Admin/InsuranceHealthDetail/Index';
        },
        error: function (xhr, status, error) {
          alert("Error updating Insurance Health Detail: " + error);
        }
      });
    });
  });
</script>
}
