@using Microsoft.AspNetCore.Mvc
@model Project_Sem3.Models.ViewModel.NavbarViewModel

<nav class="navbar navbar-expand-lg bg-white navbar-light sticky-top px-4 px-lg-5">
    <a href="@Url.Action("Index", "Home")" class="navbar-brand d-flex align-items-center">
        <h1 class="m-0"><img class="img-fluid me-3" src="~/user/img/icon/icon-02-primary.png" alt="">Insure</h1>
    </a>
    <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarCollapse">
        <div class="navbar-nav mx-auto bg-light rounded pe-4 py-3 py-lg-0">
            <!-- Các mục navbar chính -->
            @foreach (var item in Model.Items.Take(4))
            {
                var isActive = Model.CurrentController == item.Controller && Model.CurrentAction == item.Action;
                <a href="@Url.Action(item.Action, item.Controller)" class="nav-item nav-link @(isActive ? "active" : "")">@item.Text</a>
            }

            <!-- Dropdown Pages -->
            <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle @(Model.Items.Skip(4).Any(p => Model.CurrentController == p.Controller && Model.CurrentAction == p.Action) ? "active" : "")" data-bs-toggle="dropdown">Customer Support</a>
                <div class="dropdown-menu bg-light border-0 m-0">
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <p>No items available</p>
                    }
                    @foreach (var item in Model.Items.Skip(4))
                    {
                        var isPageActive = Model.CurrentController == item.Controller && Model.CurrentAction == item.Action;
                        <a href="@Url.Action(item.Action, item.Controller)" class="dropdown-item @(isPageActive ? "active" : "")">@item.Text</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Kiểm tra trạng thái đăng nhập -->
    @if (!Model.IsLoggedIn)
    {
        <a href="@Url.Action("Login", "loginAndRegister")" class="btn btn-primary px-3 d-none d-lg-block" style="margin-right:10px">Login</a>
        <a href="@Url.Action("Register", "loginAndRegister")" class="btn btn-primary px-3 d-none d-lg-block">Register</a>
    }
</nav>
