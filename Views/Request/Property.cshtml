@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
ViewData["Title"] = "Property (Home) Insurance";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Thông tin gói bảo hiểm đã chọn -->
<div class="mb-3">
  <label class="form-label">Selected Insurance Plan</label>
  <input type="text" class="form-control" id="planName" disabled />
  <small class="form-text text-muted">Plan ID: <span id="planId"></span></small>
</div>

<!-- Form nhập liệu -->
<form id="insuranceForm">
  <!-- Property Type -->
  <div class="mb-3">
    <label for="propertyType" class="form-label">Property Type</label>
    <select class="form-select" id="propertyType" required>
      <option value="" disabled selected>Select property type</option>
      <option value="House">House</option>
      <option value="Apartment">Apartment</option>
      <option value="Condominium">Condominium</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <!-- House Type (HouseTypeIds) -->
  <div class="mb-3">
    <label class="form-label">House Type (Select all that apply)</label>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="houseType0" name="houseType" value="0">
      <label class="form-check-label" for="houseType0">Single-family house</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="houseType1" name="houseType" value="1">
      <label class="form-check-label" for="houseType1">Multi-family house</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="houseType2" name="houseType" value="2">
      <label class="form-check-label" for="houseType2">Townhouse</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="houseType3" name="houseType" value="3">
      <label class="form-check-label" for="houseType3">Villa</label>
    </div>
  </div>

  <!-- Location (City) -->
  <div class="mb-3">
    <label for="cityIds" class="form-label">City (Select all that apply)</label>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="city0" name="city" value="0">
      <label class="form-check-label" for="city0">Buôn Ma Thuột</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="city1" name="city" value="1">
      <label class="form-check-label" for="city1">Hồ Chí Minh</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="city2" name="city" value="2">
      <label class="form-check-label" for="city2">Hà Nội</label>
    </div>
  </div>

  <!-- Asset Age -->
  <div class="mb-3">
    <label for="assetAge" class="form-label">Asset Age (Years)</label>
    <input type="number" class="form-control" id="assetAge" min="0" placeholder="Enter asset age" required />
  </div>

  <!-- Construction Material -->
  <div class="mb-3">
    <label for="materialIds" class="form-label">Construction Material (Select all that apply)</label>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="material0" name="material" value="0">
      <label class="form-check-label" for="material0">Wood</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="material1" name="material" value="1">
      <label class="form-check-label" for="material1">Concrete</label>
    </div>
  </div>

  <!-- Detail -->
  <div class="mb-3">
    <label for="detail" class="form-label">Detail</label>
    <textarea class="form-control" id="detail" rows="3" placeholder="Enter additional details about the property" required></textarea>
  </div>

  <!-- Coverage Amount -->
  <div class="mb-3">
    <label for="coverageAmount" class="form-label">Coverage Amount (VND) (one year)</label>
    <input type="text" class="form-control" id="coverageAmount" disabled />
  </div>

  <!-- Contract Duration -->
  <div class="mb-3">
    <label for="contractDuration" class="form-label">Contract Duration (Years)</label>
    <input type="number" class="form-control" id="contractDuration" min="1" placeholder="Enter duration" required />
  </div>

  <!-- Region -->
  <div class="mb-3">
    <label for="region" class="form-label">Region</label>
    <select class="form-control" id="region" required>
      <option value="" disabled selected>Region</option>
      <option value="North">North</option>
      <option value="West">West</option>
      <option value="East">East</option>
      <option value="South">South</option>
    </select>
  </div>
</form>

<!-- Nhúng component hiển thị kết quả -->
<h4 class="mt-4">Insurance Details</h4>
@Html.Partial("~/Views/Shared/Components/_Readonly.cshtml")
<div><button class="btn btn-warning" onclick="sendInsurancePropertyDetail()">Contract Requirements</button></div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
<script>
  const defaultData = {
    propertyType: "House",
    houseTypeIds: [0], // Single-family house
    cityIds: [0], // Buôn Ma Thuột
    assetAge: 10,
    materialIds: [0], // Wood
    detail: "Newly built single-family house",
    coverageAmount: 1000000000,
    contractDuration: 1,
    region: "North"
  };

  $(document).ready(function () {
    const selectedPlan = JSON.parse(localStorage.getItem("selectedPlan"));

    if (selectedPlan) {
      $("#planName").val(selectedPlan.name || "Unknown Plan");
      $("#planId").text(selectedPlan.id || "N/A");
      $("#coverageAmount").val(formatVND(selectedPlan.coverageAmount));
    } else {
      console.log("Không tìm thấy dữ liệu gói bảo hiểm trong localStorage.");
      $("#planName").val("Default Plan");
      $("#planId").text("N/A");
      $("#coverageAmount").val(formatVND(defaultData.coverageAmount));
    }

    calculateInsurance();
    setupEventListeners();
  });

  function saveFormData() {
    const selectedPlan = JSON.parse(localStorage.getItem("selectedPlan")) || {};
    const formData = {
      propertyType: $("#propertyType").val() || defaultData.propertyType,
      houseTypeIds: $('input[name="houseType"]:checked').map(function() { return parseInt(this.value); }).get(),
      cityIds: $('input[name="city"]:checked').map(function() { return parseInt(this.value); }).get(),
      assetAge: parseInt($("#assetAge").val()) || defaultData.assetAge,
      materialIds: $('input[name="material"]:checked').map(function() { return parseInt(this.value); }).get(),
      detail: $("#detail").val() || defaultData.detail,
      coverageAmount: selectedPlan.coverageAmount || defaultData.coverageAmount,
      contractDuration: parseInt($("#contractDuration").val()) || defaultData.contractDuration,
      region: $("#region").val() || defaultData.region
    };
    localStorage.setItem("insuranceData", JSON.stringify(formData));
  }

  function formatVND(number) {
    return number.toLocaleString("vi-VN", { style: "currency", currency: "VND" }).replace("₫", "").trim();
  }

  function setupEventListeners() {
    const debounce = (func, delay) => {
      let timeoutId;
      return (...args) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => func.apply(null, args), delay);
      };
    };
    $("#contractDuration, #assetAge").on("input", debounce(calculateInsurance, 500));
    $("#propertyType, #region, #detail").on("change", calculateInsurance);
    $('input[name="houseType"], input[name="city"], input[name="material"]').on("change", calculateInsurance);
  }

  function calculateInsurance() {
    const selectedPlan = JSON.parse(localStorage.getItem("selectedPlan")) || {};
    const propertyType = $("#propertyType").val() || "";
    const houseTypeIds = $('input[name="houseType"]:checked').map(function() { return parseInt(this.value); }).get();
    const cityIds = $('input[name="city"]:checked').map(function() { return parseInt(this.value); }).get();
    const assetAge = parseInt($("#assetAge").val()) || 0;
    const materialIds = $('input[name="material"]:checked').map(function() { return parseInt(this.value); }).get();
    const coverageAmount = selectedPlan.coverageAmount || defaultData.coverageAmount;
    const contractDuration = parseInt($("#contractDuration").val()) || 0;

    // Validation
    if (!propertyType) return showError("Please select a property type.");
    if (houseTypeIds.length === 0) return showError("Please select at least one house type.");
    if (cityIds.length === 0) return showError("Please select at least one city.");
    if (assetAge < 0) return showError("Asset age cannot be negative.");
    if (materialIds.length === 0) return showError("Please select at least one construction material.");
    if (!coverageAmount) return showError("Coverage amount is missing.");
    if (contractDuration <= 0) return showError("Contract duration must be greater than 0.");

    const requestData = {
      propertyType: propertyType,
      houseTypeIds: houseTypeIds,
      cityIds: cityIds,
      assetAge: assetAge,
      materialIds: materialIds,
      coverageAmount: coverageAmount,
      contractDuration: contractDuration
    };
    console.log(requestData);

    saveFormData();

    $.ajax({
      url: "/api/insurance/calculate/property",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(requestData),
      success: function (response) {
        hideLoading();
        updateResult(response);
      },
      error: function (xhr) {
        hideLoading();
        showError(`Error: ${xhr.responseText || "Something went wrong."}`);
      }
    });
  }

  function updateResult(response) {
    $("#annualPaymentAmount").val(formatVND(response.annualPaymentAmount));
    $("#premium").val(formatVND(response.premium));
    $("#deductible").val(formatVND(response.deductible));
    $("#resultCoverageAmount").val(formatVND(response.coverageAmount));
    $("#riskFactor").val(response.riskFactor.toFixed(3));
    $("#errorAlert").addClass("d-none");
  }

  function showError(message) {
    $("#errorAlert").text(message).removeClass("d-none");
    $("#annualPaymentAmount").val("");
    $("#premium").val("");
    $("#deductible").val("");
    $("#resultCoverageAmount").val("");
    $("#riskFactor").val("");
  }

  function getAllValues() {
    const selectedPlan = JSON.parse(localStorage.getItem("selectedPlan")) || {};
    const propertyType = $("#propertyType").val() || "";
    const houseTypeIds = $('input[name="houseType"]:checked').map(function() { return parseInt(this.value); }).get();
    const location = $('input[name="city"]:checked').map(function() { return $(this).next().text(); }).get().join(", ");
    const assetAge = parseInt($("#assetAge").val()) || 0;
    const contractDuration = parseInt($("#contractDuration").val()) || 0;
    const detail = $("#detail").val() || "";
    const annualPaymentAmount = $("#annualPaymentAmount").val() ? parseFloat($("#annualPaymentAmount").val().replace(/,/g, '')) : 0;
    const premium = $("#premium").val() ? parseFloat($("#premium").val().replace(/,/g, '')) : 0;
    const deductible = $("#deductible").val() ? parseFloat($("#deductible").val().replace(/,/g, '')) : 0;
    const riskFactor = $("#riskFactor").val() ? parseFloat($("#riskFactor").val()) : 0;
    const region = $("#region").val() || null;

    return {
      planId: selectedPlan.id || 0,
      propertyType: propertyType,
      location: location,
      duration: contractDuration * 12,
      riskFactor: riskFactor,
      region: region,
      annualPaymentAmount: annualPaymentAmount,
      premium: premium,
      deductible: deductible,
      status: 0, // Giả định "Pending" là 0 trong enum StatusType
      houseTypeIds: houseTypeIds,
      detail: detail // Thêm trường detail
    };
  }

  function sendInsurancePropertyDetail() {
    const data = getAllValues();

    // Validation trước khi gửi
    if (data.planId === 0) return alert("Please select a valid insurance plan.");
    if (!data.propertyType) return alert("Please select a property type.");
    if (!data.houseTypeIds || data.houseTypeIds.length === 0) return alert("Please select at least one house type.");
    if (!data.location) return alert("Please select at least one city.");
    if (!data.detail) return alert("Please enter property details.");
    if (data.annualPaymentAmount === 0) return alert("Annual payment amount is required.");
    if (data.premium === 0) return alert("Premium is required.");
    if (data.deductible === 0) return alert("Deductible is required.");
    if (!data.region) return alert("Please select a region.");

    showLoading();
    $.ajax({
      url: "/api/insurance-property",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(data),
      success: function (response) {
        showSuccess();
        setTimeout(function () {
          window.location.href = "/Home/PageSuccess";
        }, 2000);
      },
      error: function (xhr) {
        console.log("Error:", xhr.responseText);
        hideLoading();
        alert("Please enter enough information");
      }
    });
  }


</script>
}
