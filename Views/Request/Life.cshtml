@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Org.BouncyCastle.Crypto.Engines
@{
ViewData["Title"] = "Life Insurance";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Thông tin gói bảo hiểm đã chọn -->
<div class="mb-3">
  <label class="form-label">Selected Insurance Plan</label>
  <input type="text" class="form-control" id="planName" disabled />
  <small class="form-text text-muted">Plan ID: <span id="planId"></span></small>
</div>

<!-- Form nhập liệu -->
<form id="insuranceForm">
  <div class="mb-3">

    <label for="age" class="form-label">Age</label>
    <input type="number" class="form-control" id="age" min="0" placeholder="Enter your age" required/>
  </div>
  <div class="mb-3">
    <label for="beneficiaries" class="form-label">Beneficiaries</label>
    <input type="text" id="beneficiaries" class="form-control" placeholder="Enter your beneficiaries" required/>
  </div>
  <!-- Health Status với Checkboxes -->
  <div class="mb-3">
    <label class="form-label">Health Status (Select all that apply)</label>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus0" name="healthStatus" value="0">
      <label class="form-check-label" for="healthStatus0">Healthy</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus1" name="healthStatus" value="1">
      <label class="form-check-label" for="healthStatus1">Obesity</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus2" name="healthStatus" value="2">
      <label class="form-check-label" for="healthStatus2">Mild diabetes</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus3" name="healthStatus" value="3">
      <label class="form-check-label" for="healthStatus3">Severe diabetes</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus4" name="healthStatus" value="4">
      <label class="form-check-label" for="healthStatus4">Hypertension</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus5" name="healthStatus" value="5">
      <label class="form-check-label" for="healthStatus5">Cardiovascular</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus6" name="healthStatus" value="6">
      <label class="form-check-label" for="healthStatus6">Smoke</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="healthStatus7" name="healthStatus" value="7">
      <label class="form-check-label" for="healthStatus7">Other</label>
    </div>
  </div>

  <!-- Career với Select -->
  <div class="mb-3">
    <label for="career" class="form-label">Career</label>
    <select class="form-select" id="career" name="career" aria-label="Career select">
      <option value="" selected>Open this select menu</option>
      <option value="0">Firefighter</option>
      <option value="1">Pilot</option>
      <option value="2">Lumberjack</option>
      <option value="3">Waste Collector & Recycler</option>
      <option value="4">Underwater Welder</option>
      <option value="5">Oil Rig Worker</option>
      <option value="6">Construction Worker</option>
      <option value="7">Deep Sea Fisherman</option>
      <option value="8">Steelworker</option>
      <option value="9">Bullfighter</option>
      <option value="10">Miner</option>
      <option value="11">Farmer</option>
      <option value="12">Police Officer</option>
      <option value="13">Truck Driver</option>
      <option value="14">Stunt Performer</option>
      <option value="15">Other</option>
    </select>
  </div>

  <!-- Coverage Amount thay bằng input readonly -->
  <div class="mb-3">
    <label for="coverageAmount" class="form-label">Coverage Amount (VND) (one year)</label>
    <input type="text" class="form-control" id="coverageAmount" disabled />
  </div>

  <!-- Thêm StartDate -->
  <div class="mb-3">
    <label for="startDate" class="form-label">Start Date</label>
    <input type="date" class="form-control" id="startDate" name="startDate" required min="@DateTime.Now.ToString("yyyy-MM-dd")"/>
  </div>

  <!-- Contract Duration -->
  <div class="mb-3">
    <label for="contractDuration" class="form-label">Contract Duration (Years)</label>
    <input type="number" class="form-control" id="contractDuration" min="1" placeholder="Enter duration" required/>
  </div>

  <!-- EndDate (readonly) -->
  <div class="mb-3">
    <label for="endDate" class="form-label">End Date</label>
    <input type="date" class="form-control" id="endDate" name="endDate" readonly/>
  </div>

  <div>
    <label for="region" class="form-label">Region</label>
    <select class="form-control" id="region" required>
      <option value="" disabled selected>Region</option>
      <option value="North">North</option>
      <option value="West">West</option>
      <option value="East">East</option>
      <option value="South">South</option>
    </select>
  </div>
</form>

<h4 class="mt-4">Insurance Details</h4>
@Html.Partial("~/Views/Shared/Components/_Readonly.cshtml")
<div><button class="btn btn-primary" onclick="sendInsuranceLifeDetail()">Contract Requirements</button></div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
<script>
  const currentUserId = @ViewData["UserId"] ?? null;
  console.log(currentUserId)
  let detailId ;
  let planId ;
  const defaultData = {
    age: 30,
    healthStatus: [0],
    career: [1],
    coverageAmount: 1000000000,
    contractDuration: 10
  };

  $(document).ready(function () {
    const selectedPlan = JSON.parse(localStorage.getItem("selectedPlan"));
    if (selectedPlan) {
      planId = selectedPlan.id || 0
      $("#planName").val(selectedPlan.name || "Unknown Plan");
      $("#planId").text(selectedPlan.id || "N/A");
      $("#coverageAmount").val(formatVND(selectedPlan.coverageAmount));
    } else {
      console.log("No insurance plan data found in localStorage.");
      $("#planName").val("Default Plan");
      $("#planId").text("N/A");
      $("#coverageAmount").val(formatVND(defaultData.coverageAmount));
    }

    // Tự động tính EndDate khi StartDate hoặc ContractDuration thay đổi
    $('#startDate, #contractDuration').on('change', calculateEndDate);

    calculateInsurance();
    setupEventListeners();
  });

  function formatVND(number) {
    return number.toLocaleString("vi-VN", { style: "currency", currency: "VND" }).replace("₫", "").trim();
  }
  function parseVNDToNumber(vndString) {
    // Loại bỏ tất cả dấu chấm và thay bằng "" để đảm bảo chỉ còn số nguyên
    return parseFloat(vndString.replace(/\./g, ""));
  }
  function calculateEndDate() {
    var startDate = $('#startDate').val();
    var contractDuration = parseInt($('#contractDuration').val()) || 0;
    if (startDate && contractDuration > 0) {
      var start = new Date(startDate);
      var end = new Date(start);
      end.setFullYear(start.getFullYear() + contractDuration);
      $('#endDate').val(end.toISOString().split('T')[0]);
    } else {
      $('#endDate').val('');
    }
  }

  function setupEventListeners() {
    const debounce = (func, delay) => {
      let timeoutId;
      return (...args) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => func.apply(null, args), delay);
      };
    };
    $("#age, #contractDuration").on("input", debounce(calculateInsurance, 500));
    $("#career").on("change", calculateInsurance);
    $('input[name="healthStatus"]').on("change", calculateInsurance);
  }

  function calculateInsurance() {
    const selectedPlan = JSON.parse(localStorage.getItem("selectedPlan")) || {};
    const age = parseInt($("#age").val()) || 0;
    const healthStatus = $('input[name="healthStatus"]:checked').map(function() {
      return parseInt(this.value);
    }).get();
    const career = $("#career").val() ? [parseInt($("#career").val())] : [];
    const coverageAmount = selectedPlan.coverageAmount || defaultData.coverageAmount;
    const contractDuration = parseInt($("#contractDuration").val()) || 0;

    if (age <= 0 || !coverageAmount || contractDuration <= 0 || healthStatus.length === 0 || career.length === 0 || (healthStatus.includes(0) && healthStatus.length > 1)) {
      return;
    }

    const requestData = {
      age: age,
      healthStatusIds: healthStatus,
      careerIds: career,
      coverageAmount: coverageAmount,
      contractDuration: contractDuration
    };

    $.ajax({
      url: "/api/insurance/calculate/life",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(requestData),
      success: function (response) {
        updateResult(response);
      },
      error: function (xhr) {
        showError(`Error: ${xhr.responseText || "Something went wrong."}`);
      }
    });
  }

  function updateResult(response) {
    $("#annualPaymentAmount").val(formatVND(response.annualPaymentAmount));
    $("#premium").val(formatVND(response.premium));
    $("#deductible").val(formatVND(response.deductible));
    $("#resultCoverageAmount").val(formatVND(response.coverageAmount));
    $("#riskFactor").val(response.riskFactor.toFixed(3));
    $("#errorAlert").addClass("d-none");
  }

  function showError(message) {
    $("#errorAlert").text(message).removeClass("d-none");
    $("#annualPaymentAmount").val("");
    $("#premium").val("");
    $("#deductible").val("");
    $("#resultCoverageAmount").val("");
    $("#riskFactor").val("");
  }

  function getAllValues() {
    const selectedPlan = JSON.parse(localStorage.getItem("selectedPlan")) || {};
    const age = parseInt($("#age").val()) || 0;
    const healthStatus = $('input[name="healthStatus"]:checked').map(function() {
      return parseInt(this.value);
    }).get();
    const career = $("#career").val() ? [parseInt($("#career").val())] : [];
    const coverageAmount = selectedPlan.coverageAmount || defaultData.coverageAmount;
    const contractDuration = parseInt($("#contractDuration").val()) || 0;
    const beneficiaries = $("#beneficiaries").val() || null;
    const annualPaymentAmount = $("#annualPaymentAmount").val() ? parseVNDToNumber($("#annualPaymentAmount").val()) : 0;
    const premium = $("#premium").val() ? parseVNDToNumber($("#premium").val()) : 0;
    const deductible = $("#deductible").val() ? parseVNDToNumber($("#deductible").val()) : 0;
    const riskFactor = $("#riskFactor").val() ? parseFloat($("#riskFactor").val()) : 0;
    const region = $("#region").val() || null;

    const ageGroup = age < 30 ? "(1-30)" : age < 40 ? "30-40" : age < 50 ? "40-50" : "50+";

    return {
      planId: planId,
      ageGroup: ageGroup,
      beneficiaries: beneficiaries,
      healthStatus: healthStatus,
      career: career,
      termYears: contractDuration,
      annualPaymentAmount: annualPaymentAmount,
      premium: premium,
      duration: contractDuration * 12,
      deductible: deductible,
      riskFactor: riskFactor,
      region: region,
    };
  }

  function getContractValue(detailId){
    return{
      UserId : currentUserId,
      PlanId : planId,
      startDate: $('#startDate').val() + "T00:00:00",
      endDate: $('#endDate').val() + "T00:00:00" ,    // Gửi EndDate
      detailId : detailId
    }
  }

  function checkUserId() {
    if (!currentUserId) {
      alert("Please login to create an insurance contract");
      return false;
    }
    return true;
  }

  function sendInsuranceLifeDetail() {
    if (!checkUserId()) return;
    showLoading()
    const data = getAllValues();
    console.log("Sending data:", data);
    $.ajax({
      url: "/api/insurance-life",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(data),
      success: function (response) {
        console.log("Response:", response);
        detailId = response.detailId;
        console.log("detail id" , detailId)
       const dataContract =   getContractValue(detailId)
        console.log(dataContract)
        alert("miss")
        saveContract(dataContract)
      },
      error: function (xhr) {
        console.log("Error:", xhr.responseText);
        alert("Please enter enough information");
        hideLoading()
      }
    });
  }

  function saveContract(data){
    $.ajax({
      url : "/api/insurance-contracts",
      method : "POST",
      contentType : "application/json",
      data : JSON.stringify(data),
      success: function (response){
        console.log("contract",response)
        showSuccess();
        setTimeout(function () {window.location.href = "/Home/PageSuccess";}, 2000);
      },
      error: function (xhr) {
        console.log("Error:", xhr.responseText);
        alert("Please enter enough information");
        hideLoading()
      }
    })
  }

</script>
}
