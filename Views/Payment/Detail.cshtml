@model int

@{
ViewData["Title"] = "Payment Detail";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
  body {
    background: linear-gradient(135deg, #f0f2f5 0%, #ffffff 100%);
    font-family: 'Segoe UI', sans-serif;
    min-height: 100vh;
  }
  .container {
    margin-top: 60px;
    max-width: 700px;
  }
  .detail-card {
    background: #fff;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .detail-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }
  .detail-title {
    font-size: 28px;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 25px;
    text-align: center;
  }
  .detail-info {
    font-size: 16px;
  }
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #ececec;
  }
  .detail-row:last-child {
    border-bottom: none;
  }
  .detail-label {
    font-weight: 500;
    color: #34495e;
    flex: 1;
  }
  .detail-value {
    color: #555;
    flex: 2;
    text-align: right;
  }
  .detail-image {
    border-radius: 8px;
    margin-top: 10px;
    transition: transform 0.3s ease;
  }
  .detail-image:hover {
    transform: scale(1.05);
  }
  .loading {
    text-align: center;
    padding: 20px;
  }
  .error-alert {
    display: none;
    background: #f8d7da;
    color: #721c24;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    text-align: center;
  }
</style>

<div class="container">
  <div class="detail-card">
    <h2 class="detail-title">Payment Details</h2>
    <div class="detail-info">
      <div id="transaction-details" class="loading">
        <img src="https://loading.io/spinners/dual-ring/lg.dual-ring-spinner.gif" alt="Loading..." />
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
  const transactionId = @Model; // Pass the model value to JavaScript

  console.log("Transaction ID:", transactionId);

  $(document).ready(function() {
    $.ajax({
      url: `/api/payments/${transactionId}`,
      method: 'GET',
      success: function(data) {
        const statusMap = {
          0: 'Pending',
          1: 'Completed',
          2: 'Failed'
        };
        const statusText = statusMap[data.status] || 'N/A';

        const detailHtml = `
                        <div class="detail-row">
                            <span class="detail-label">Transaction ID:</span>
                            <span class="detail-value">${data.id}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Contract ID:</span>
                            <span class="detail-value">${data.contractId}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Amount:</span>
                            <span class="detail-value">${data.amount} VND</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Payment Date:</span>
                            <span class="detail-value">${new Date(data.paymentDate).toLocaleDateString('en-US')}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Status:</span>
                            <span class="detail-value">${statusText}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Image:</span>
                            <span class="detail-value">
                                <img src="${data.imageUrl}" alt="Payment Image" class="detail-image" style="width: 200px; height: 200px;">
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Created At:</span>
                            <span class="detail-value">${new Date(data.createdAt).toLocaleDateString('en-US')}</span>
                        </div>
                    `;
        $('#transaction-details').html(detailHtml);
      },
      error: function(error) {
        $('#transaction-details').html('<div class="error-alert">Error loading transaction details.</div>');
      }
    });
  });
</script>
}
