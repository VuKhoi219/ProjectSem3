@{
ViewData["Title"] = "Create Payment";
}

<style>
  body {
    background: linear-gradient(135deg, #e9ecef 0%, #f4f7f6 100%);
    font-family: 'Poppins', sans-serif;
    min-height: 100vh;
    margin: 0;
    padding: 0;
  }
  .container {
    margin-top: 80px;
    max-width: 600px;
    padding: 30px;
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }
  .container:hover {
    transform: translateY(-5px);
  }
  h2 {
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 30px;
    text-align: center;
  }
  .form-group {
    margin-bottom: 25px;
  }
  .form-group label {
    font-weight: 500;
    color: #34495e;
    margin-bottom: 8px;
    display: block;
  }
  .form-control, .form-control-file {
    border: 2px solid #dfe6e9;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .form-control:focus, .form-control-file:focus {
    border-color: #28a745;
    box-shadow: 0 0 8px rgba(40, 167, 69, 0.2);
    outline: none;
  }
  .btn-custom {
    background: linear-gradient(90deg, #28a745, #218838);
    color: #fff;
    border: none;
    padding: 14px;
    font-size: 16px;
    font-weight: 500;
    border-radius: 8px;
    transition: background 0.3s ease, transform 0.2s ease;
    width: 100%;
  }
  .btn-custom:hover {
    background: linear-gradient(90deg, #218838, #1e7e34);
    transform: translateY(-2px);
  }
  .alert {
    display: none;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
    font-size: 16px;
    animation: fadeIn 0.5s ease;
  }
  .alert-success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }
  .alert-danger {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }
  #loadingSpinner {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1000;
  }
  keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<body>
<div class="container">
  <h2>Create Payment</h2>

  <!-- Success and Error Alerts -->
  <div id="successAlert" class="alert alert-success">
    <strong>Success!</strong> Payment created successfully.
  </div>
  <div id="errorAlert" class="alert alert-danger">
    <strong>Error!</strong> Something went wrong, please try again.
  </div>

  <!-- Loading Spinner -->
  <div id="loadingSpinner" class="spinner-border text-success" role="status">
    <span class="sr-only">Loading...</span>
  </div>

  <!-- Payment Form -->
  <form id="paymentForm" enctype="multipart/form-data">
    <div class="form-group">
      <label for="contractId">Contract ID</label>
      <input type="number" class="form-control" id="contractId" placeholder="Enter Contract ID" required>
    </div>
    <div class="form-group">
      <label for="amount">Amount</label>
      <input type="number" class="form-control" id="amount" placeholder="Enter Amount" required>
    </div>
    <div class="form-group">
      <label for="paymentImage">Payment Image</label>
      <input type="file" class="form-control-file" id="paymentImage" accept=".jpg,.jpeg,.png,.pdf" required>
    </div>
    <button type="submit" class="btn btn-custom">Create Payment</button>
  </form>
</div>

@section Scripts {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
  $(document).ready(function() {
    $('#paymentForm').on('submit', function(e) {
      e.preventDefault();

      // Show loading spinner
      $('#loadingSpinner').show();

      // Create FormData for file upload
      const formData = new FormData();
      formData.append('file', $('#paymentImage')[0].files[0]);

      // Step 1: Upload file first
      $.ajax({
        url: '/api/upload',
        method: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function(fileResponse) {
          // After successful upload, get the file URL
          const imageUrl = fileResponse.filePath;

          // Step 2: Create payment with the uploaded URL
          const paymentData = {
            userId: @ViewData["UserId"] ?? null,
            contractId: $('#contractId').val(),
            amount: $('#amount').val(),
            imageUrl: imageUrl
          };

          $.ajax({
            url: '/api/payments',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(paymentData),
            success: function(paymentResponse) {
              $('#loadingSpinner').hide();
              $('#successAlert').show();
              $('#errorAlert').hide();
              setTimeout(function() {
                window.location.href = "/Payment/Index";
              }, 2000);
            },
            error: function(xhr, status, error) {
              $('#loadingSpinner').hide();
              $('#successAlert').hide();
              $('#errorAlert').show();
            }
          });
        },
        error: function(xhr, status, error) {
          $('#loadingSpinner').hide();
          $('#successAlert').hide();
          $('#errorAlert').show();
        }
      });
    });
  });
</script>
}
</body>
