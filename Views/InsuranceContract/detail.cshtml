@using Microsoft.AspNetCore.Mvc
@{
ViewData["Title"] = "Payments";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
  body {
    font-family: Arial, sans-serif;
    margin: 20px;
    background-color: #f4f4f4;
  }
  .insurance-card {
    background: white;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    max-width: 600px;
    display: none; /* Hidden initially until data is loaded */
  }
  .insurance-card h2 {
    color: #2c3e50;
    margin-top: 0;
  }
  .detail-section {
    margin-top: 15px;
  }
  .detail-section p {
    margin: 5px 0;
  }
  .label {
    font-weight: bold;
    color: #34495e;
  }
  .loading {
    font-size: 18px;
    color: #7f8c8d;
  }
  .error {
    color: red;
  }
</style>
<h1>Insurance Contract Details</h1>
<div id="loading" class="loading">Loading data...</div>
<div id="error" class="error"></div>

<div id="insurance-card" class="insurance-card">
  <h2 id="plan-name"></h2>
  <p><span class="label">Description:</span> <span id="description"></span></p>
  <p><span class="label">Annual Coverage Amount:</span> <span id="coverage-amount"></span></p>
  <p><span class="label">Start Date:</span> <span id="start-date"></span></p>
  <p><span class="label">End Date:</span> <span id="end-date"></span></p>
  <div id="detail-section" class="detail-section">
    <h3 id="detail-title"></h3>
    <!-- Detail fields will be added dynamically -->
  </div>
</div>

@section Scripts {
<!-- Add jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  const contract = JSON.parse(localStorage.getItem("contract")) || {};
  const contractId = contract.id;
  const planId = contract.planId;
  $(document).ready(function() {
    // Call API when the page loads
    $.ajax({
      url: '/api/insurance-contracts/contract-detail/' + contractId + '/' + planId,
      method: 'GET',
      success: function(response) {
        // Hide loading when data is received
        $('#loading').hide();
        const data = response.data;
        const insurancePlan = data.insurancePlan;
        $('#plan-name').text(`Insurance Plan: ${insurancePlan.name}`);
        $('#description').text(insurancePlan.description);
        $('#coverage-amount').text(insurancePlan.coverageAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#start-date').text(new Date(data.startDate).toLocaleDateString('en-US'));
        $('#end-date').text(new Date(data.endDate).toLocaleDateString('en-US'));
        const detailSection = $('#detail-section');
        if (insurancePlan.lifeDetail) {
          $('#detail-title').text('Life Insurance Details');
          appendDetail(detailSection, 'Term (years)', insurancePlan.lifeDetail.termYears);
          appendDetail(detailSection, 'Age Group', insurancePlan.lifeDetail.ageGroup);
          appendDetail(detailSection, 'Duration (months)', insurancePlan.lifeDetail.duration);
          appendDetail(detailSection, 'Risk Factor', insurancePlan.lifeDetail.riskFactor);
          appendDetail(detailSection, 'Region', insurancePlan.lifeDetail.region);
          appendDetail(detailSection, 'Annual Payment', insurancePlan.lifeDetail.annualPaymentAmount);
          appendDetail(detailSection, 'Total Premium', insurancePlan.lifeDetail.premium);
          appendDetail(detailSection, 'Deductible', insurancePlan.lifeDetail.deductible);
        } else if (insurancePlan.healthDetail) {
          $('#detail-title').text('Health Insurance Details');
          appendDetail(detailSection, 'Age Group', insurancePlan.healthDetail.ageGroup);
          appendDetail(detailSection, 'Hospital Network', insurancePlan.healthDetail.hospitalNetwork);
          appendDetail(detailSection, 'Pre-existing Conditions', insurancePlan.healthDetail.preExistingConditions);
          appendDetail(detailSection, 'Duration (months)', insurancePlan.healthDetail.duration);
          appendDetail(detailSection, 'Risk Factor', insurancePlan.healthDetail.riskFactor);
          appendDetail(detailSection, 'Region', insurancePlan.healthDetail.region);
          appendDetail(detailSection, 'Annual Payment', insurancePlan.healthDetail.annualPaymentAmount);
          appendDetail(detailSection, 'Total Premium', insurancePlan.healthDetail.premium);
          appendDetail(detailSection, 'Deductible', insurancePlan.healthDetail.deductible);
        } else if (insurancePlan.vehicleDetail) {
          $('#detail-title').text('Vehicle Insurance Details');
          appendDetail(detailSection, 'Vehicle Type', insurancePlan.vehicleDetail.vehicleType);
          appendDetail(detailSection, 'Vehicle Model', insurancePlan.vehicleDetail.vehicleModel);
          appendDetail(detailSection, 'Manufacturing Year', insurancePlan.vehicleDetail.vehicleYear);
          appendDetail(detailSection, 'Duration (months)', insurancePlan.vehicleDetail.duration);
          appendDetail(detailSection, 'Risk Factor', insurancePlan.vehicleDetail.riskFactor);
          appendDetail(detailSection, 'Region', insurancePlan.vehicleDetail.region);
          appendDetail(detailSection, 'Annual Payment', insurancePlan.vehicleDetail.annualPaymentAmount);
          appendDetail(detailSection, 'Total Premium', insurancePlan.vehicleDetail.premium);
          appendDetail(detailSection, 'Deductible', insurancePlan.vehicleDetail.deductible);
        } else if (insurancePlan.propertyDetail) {
          $('#detail-title').text('Property Insurance Details');
          appendDetail(detailSection, 'Property Type', insurancePlan.propertyDetail.propertyType);
          appendDetail(detailSection, 'Location', insurancePlan.propertyDetail.location);
          appendDetail(detailSection, 'Duration (months)', insurancePlan.propertyDetail.duration);
          appendDetail(detailSection, 'Risk Factor', insurancePlan.propertyDetail.riskFactor);
          appendDetail(detailSection, 'Region', insurancePlan.propertyDetail.region);
          appendDetail(detailSection, 'Annual Payment', insurancePlan.propertyDetail.annualPaymentAmount);
          appendDetail(detailSection, 'Total Premium', insurancePlan.propertyDetail.premium);
          appendDetail(detailSection, 'Deductible', insurancePlan.propertyDetail.deductible);
        }
        $('#insurance-card').show();
      },
      error: function(xhr, status, error) {
        $('#loading').hide();
        $('#error').text('Error loading data: ' + error);
      }
    });
    function appendDetail(section, label, value) {
      section.append(`<p><span class="label">${label}:</span> ${value}</p>`);
    }
  });
</script>
}
