@using Microsoft.AspNetCore.Mvc
@{
ViewData["Title"] = "List contract";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
  body {
    background-color: #f8f9fa;
  }
  .container {
    margin-top: 30px;
  }
  .page-title {
    color: #007bff;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 30px;
  }
  .table-wrapper {
    overflow-x: auto;
  }
  .table th, .table td {
    text-align: center;
  }
  .table-striped tbody tr:nth-of-type(odd) {
    background-color: #f9f9f9;
  }
  .btn-custom {
    background-color: #28a745;
    color: white;
  }
  .btn-custom:hover {
    background-color: #218838;
  }
  .pagination {
    justify-content: center;
    margin-top: 20px;
  }
  .pagination .page-link {
    border-radius: 50%;
  }
  .alert-custom {
    margin-top: 20px;
    text-align: center;
  }
</style>
<>
<div >
  <h2 class="page-title text-center">List of contracts</h2>
  <div id="ContractTable" class="table-wrapper">
    <!-- Dữ liệu sẽ được load vào đây -->
  </div>

  <!-- Pagination controls -->
  <div id="pagination" class="pagination">
    <!-- Pagination sẽ được load vào đây -->
  </div>

  <!-- Custom Alert -->
  <div id="errorAlert" class="alert alert-danger alert-custom" style="display: none;">
    <strong>Error!</strong> Something went wrong, please try again later.
  </div>
</div>

@section Scripts {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
  let id =  @ViewData["UserId"] ?? null;
  function loadContracts(page, pageSize , userId) {
    console.log('Loading contracts for page:', page, 'pageSize:', pageSize, 'userId:', userId);
    showLoading();
    $.ajax({
      url: `/api/insurance-contracts/user/${userId}?pageNumber=${page}&pageSize=${pageSize}`,
      method: 'GET',
      success: function (response) {
        console.log('API Response:', response);
        const data = response.data.$values || [];
        hideLoading();
        if (!Array.isArray(data) || data.length === 0) {
          $('#ContractTable').html('<div class="text-center">No data available</div>');
          $('#pagination').html('');
          return;
        }
        let html = '<table class="table table-striped table-hover">';
        html += '<thead class="thead-dark"><tr><th>ID</th><th>Plan Id</th><th>Start date</th><th>End date</th><th>Status</th><th>Actions</th></tr></thead>';
        html += '<tbody>';
        data.forEach(ict => {
          const statusMap = { 0: 'Pending', 1: 'Active', 2: 'Expired', 3: 'Cancelled' };
          const statusText = statusMap[ict.status] || 'N/A';
          html += `<tr id="Contract-row-${ict.id}">
                            <td>${ict.id}</td>
                            <td>${ict.planId}</td>
                            <td>${ict.startDate}</td>
                            <td>${ict.endDate}</td>
                            <td>${statusText}</td>
                            <td>
                                <button onclick="detailContract(${ict.id || ''}, ${ict.planId || ''})"><i class='bx bx-paste'></i></button>
                            </td>
                        </tr>`;
        });
        html += '</tbody></table>';
        const currentPage = response.currentPage || page;
        const totalPages = response.totalPages || 1;
        const pagination = `
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                            <button class="page-link" onclick="loadContracts(${currentPage - 1}, ${pageSize}, '${userId}')">Previous</button>
                        </li>
                        <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                            <button class="page-link" onclick="loadContracts(${currentPage + 1}, ${pageSize}, '${userId}')">Next</button>
                        </li>
                    </ul>
                </nav>
            `;
        $('#ContractTable').html(html);
        $('#pagination').html(pagination);
      },
      error: function (xhr, status, error) {
        console.error('Error:', status, error);
        hideLoading();
        $('#ContractTable').html('<div class="text-center">Error loading data</div>');
        $('#pagination').html('');
      }
    });
  }

  function detailContract(id , planId){
      localStorage.setItem("contract", JSON.stringify({
        id: id,
        planId: planId,
      }));
      window.location.href = "/insuranceContract/detail";
  }
  $(document).ready(function () {
    loadContracts(1,10,id);
  });
</script>
}
