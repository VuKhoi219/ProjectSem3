@using Microsoft.AspNetCore.Mvc
@{
    ViewData["Title"] = "Borrow Capital Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: 'Segoe UI', Arial, sans-serif;
        margin: 40px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        color: #333;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    h1 {
        color: #2c3e50;
        text-align: center;
        margin-bottom: 40px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .borrow-card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        display: none;
        transition: transform 0.2s;
    }

    .borrow-card:hover {
        transform: translateY(-5px);
    }

    .borrow-card h2 {
        color: #2980b9;
        margin: 0 0 20px;
        font-size: 24px;
        border-bottom: 2px solid #3498db;
        padding-bottom: 10px;
    }

    .detail-section p {
        margin: 12px 0;
        padding: 8px;
        background: #f8f9fa;
        border-radius: 6px;
    }

    .label {
        font-weight: 600;
        color: #2c3e50;
        min-width: 150px;
        display: inline-block;
    }

    .loading {
        text-align: center;
        font-size: 20px;
        color: #7f8c8d;
        padding: 20px;
        background: rgba(255,255,255,0.8);
        border-radius: 8px;
    }

    .error {
        color: #e74c3c;
        text-align: center;
        padding: 15px;
        background: rgba(231, 76, 60, 0.1);
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .loan-payment {
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: transform 0.2s;
    }

    .loan-payment:hover {
        transform: translateY(-5px);
    }

    .loan-payment h3 {
        color: #2980b9;
        margin: 0 0 20px;
        font-size: 22px;
        border-bottom: 2px solid #3498db;
        padding-bottom: 10px;
    }

    #createPaymentLink {
        display: inline-block;
        padding: 8px 16px;
        background: #2ecc71;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        margin-bottom: 15px;
        transition: background 0.3s;
    }

    #createPaymentLink:hover {
        background: #27ae60;
    }

    .loan-payment table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .loan-payment th {
        background: #ecf0f1;
        color: #2c3e50;
        font-weight: 600;
        padding: 12px;
        text-align: left;
    }

    .loan-payment td {
        padding: 12px;
        border-bottom: 1px solid #eee;
    }

    .loan-payment tr:hover {
        background: #f8f9fa;
    }

    .loan-payment img {
        max-width: 80px;
        border-radius: 4px;
        transition: transform 0.2s;
    }

    .loan-payment img:hover {
        transform: scale(1.5);
    }
</style>

<div class="container">
    <h1>Loan Details</h1>
    <div id="loading" class="loading">Loading data...</div>
    <div id="error" class="error"></div>

    <div id="borrow-card" class="borrow-card">
        <h2 id="title">Loan Information</h2>
        <div class="detail-section">
            <p><span class="label">Loan ID:</span> <span id="id"></span></p>
            <p><span class="label">Loan Amount:</span> <span id="loanAmount"></span></p>
            <p><span class="label">Repayment Amount:</span> <span id="repaymentAmount"></span></p>
            <p><span class="label">Monthly Payment:</span> <span id="monthlyPaymentAmount"></span></p>
            <p><span class="label">Loan Date:</span> <span id="loanDate"></span></p>
            <p><span class="label">Due Date:</span> <span id="dueDate"></span></p>
            <p><span class="label">Status:</span> <span id="status"></span></p>
        </div>
    </div>

    <div id="listLoanPayment" class="loan-payment">
        <h3>Payment History</h3>
        <a href="#" id="createPaymentLink">Add Transaction</a>
        <table id="paymentTable">
            <thead>
                <tr>
                    <th>Transaction ID</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Image</th>
                    <th>Overdue Days</th>
                    <th>Penalty</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="paymentList"></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  $(document).ready(function() {
    const borrowCapital = JSON.parse(localStorage.getItem("BorrowCapital")) || {};
    const borrowCapitalId = borrowCapital.id;

    if (!borrowCapitalId) {
      $('#loading').hide();
      $('#error').text('No loan ID found in localStorage.');
      return;
    }

    let monthlyPaymentAmount;
    let loanDate;

    $.ajax({
      url: `/api/borrow-capital/${borrowCapitalId}`,
      method: 'GET',
      success: function(response) {
        $('#loading').hide();
        const loanDateObj = new Date(response.loanDate);
        const dueDate = new Date(response.dueDate);
        const monthsDiff = (dueDate.getFullYear() - loanDateObj.getFullYear()) * 12 + (dueDate.getMonth() - loanDateObj.getMonth());
        monthlyPaymentAmount = monthsDiff > 0 ? response.repaymentAmount / monthsDiff : response.repaymentAmount;
        loanDate = response.loanDate.split('T')[0];

        $('#id').text(response.id);
        $('#loanAmount').text(response.loanAmount.toLocaleString('en-US', { style: 'currency', currency: 'VND' }));
        $('#repaymentAmount').text(response.repaymentAmount.toLocaleString('en-US', { style: 'currency', currency: 'VND' }));
        $('#monthlyPaymentAmount').text(monthlyPaymentAmount.toLocaleString('en-US', { style: 'currency', currency: 'VND' }));
        $('#loanDate').text(loanDateObj.toLocaleDateString('en-US'));
        $('#dueDate').text(dueDate.toLocaleDateString('en-US'));
        const statusMap = { 0: 'Pending', 1: 'Active', 2: 'Overdue', 3: 'Closed' };
        $('#status').text(statusMap[response.status] || 'N/A');
        $('#borrow-card').show();

        // When clicking "Add Transaction"
        $('#createPaymentLink').on('click', function(e) {
          e.preventDefault();
          localStorage.setItem("LoanPaymentData", JSON.stringify({
            borrowCapitalId: borrowCapitalId,
            monthlyPaymentAmount: monthlyPaymentAmount,
            nowDateTime: new Date().toISOString().split('T')[0],
            loanDateTime: loanDate
          }));
          window.location.href = "/LoanPayment/Create";
        });
      },
      error: function(xhr) {
        $('#loading').hide();
        $('#error').text('Error loading data: ' + (xhr.responseJSON?.message || 'Unknown error'));
      }
    });

    $.ajax({
      url: `/api/loan-payment/borrow/${borrowCapitalId}`,
      method: 'GET',
      success: function(response) {
        const paymentList = $('#paymentList');
        paymentList.empty();
        console.log(response.$values)
        if (response.$values && response.$values.length > 0) {
          response.$values.forEach(payment => {
            const row = `
                                <tr>
                                    <td>${payment.id}</td>
                                    <td>${payment.paymentAmount.toLocaleString('en-US', { style: 'currency', currency: 'VND' })}</td>
                                    <td>${new Date(payment.paymentDate).toLocaleDateString('en-US')}</td>
                                    <td><img src="${payment.paymentImage}" alt="Payment Proof" onerror="this.src='/images/placeholder.jpg'"></td>
                                    <td>${payment.overdueDays}</td>
                                    <td>${payment.penaltyInterest.toLocaleString('en-US', { style: 'currency', currency: 'VND' })}</td>
                                    <td>${payment.status ? 'Paid' : 'Pending Approval'}</td>
                                </tr>`;
            paymentList.append(row);
          });
        } else {
          paymentList.append('<tr><td colspan="6">No payment history available.</td></tr>');
        }
      },
      error: function(xhr) {
        $('#error').text('Error loading history: ' + (xhr.responseJSON?.message || 'Unknown error'));
      }
    });
  });
</script>
}
