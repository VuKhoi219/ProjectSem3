@using Microsoft.AspNetCore.Mvc
@{
ViewData["Title"] = "List of Borrow capital";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
  body {
    background-color: #f8f9fa;
  }

  .container {
    margin-top: 30px;
  }

  .page-title {
    color: #007bff;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 30px;
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .table th, .table td {
    text-align: center;
  }

  .table-striped tbody tr:nth-of-type(odd) {
    background-color: #f9f9f9;
  }

  .btn-custom {
    background-color: #28a745;
    color: white;
  }

  .btn-custom:hover {
    background-color: #218838;
  }

  .pagination {
    justify-content: center;
    margin-top: 20px;
  }

  .pagination .page-link {
    border-radius: 50%;
  }

  .alert-custom {
    margin-top: 20px;
    text-align: center;
  }
  .btn-like {
    display: inline-block;
    padding: 8px 20px;
    background-color: #007bff;
    color: white;
    border-radius: 5px;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .btn-like a {
    color: white;
    text-decoration: none;
  }

  .btn-like:hover {
    background-color: #0056b3;
  }

</style>

<div>
  <h2 class="page-title text-center">List of BorrowCapitals</h2>
  <div class="btn-like">
    <a href="/BorrowCapital/Create">Create</a>
  </div>
  <div id="BorrowCapitalTable" class="table-wrapper">
    <!-- Data will be loaded here -->
  </div>

  <!-- Pagination controls -->
  <div id="pagination" class="pagination">
    <!-- Pagination will be loaded here -->
  </div>

  <!-- Custom Alert -->
  <div id="errorAlert" class="alert alert-danger alert-custom" style="display: none;">
    <strong>Error!</strong> Something went wrong, please try again later.
  </div>
</div>

@section Scripts {
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
  let id = @ViewData["UserId"] ?? null;

  function loadBorrowCapitals(page, pageSize, userId) {
    console.log('Loading BorrowCapitals for page:', page, 'pageSize:', pageSize, 'userId:', userId);
    showLoading();
    $.ajax({
      url: `/api/borrow-capital/user/${userId}?pageNumber=${page}&pageSize=${pageSize}`,
      method: 'GET',
      success: function(response) {
        console.log('API Response:', response);
        const data = response.data.$values || [];
        hideLoading();
        if (!Array.isArray(data) || data.length === 0) {
          $('#BorrowCapitalTable').html('<div class="text-center">No data available</div>');
          $('#pagination').html('');
          return;
        }
        let html = '<table class="table table-striped table-hover">';
        html += '<thead class="thead-dark"><tr><th>ID</th><th>Loan amount</th><th>Repayment amount</th><th>Status</th><th>Actions</th></tr></thead>';
        html += '<tbody>';
        data.forEach(ict => {
          const statusMap = { 0: 'Pending', 1: 'Active', 2: 'Overdue', 3: 'Closed' };
          const statusText = statusMap[ict.status] || 'N/A';
          html += `<tr id="BorrowCapital-row-${ict.id}">
                      <td>${ict.id}</td>
                      <td>${ict.loanAmount}</td>
                      <td>${ict.repaymentAmount}</td>
                      <td>${statusText}</td>
                      <td>
                          <button onclick="detailBorrowCapital(${ict.id || ''})"><i class='bx bx-paste'></i></button>
                      </td>
                  </tr>`;
        });
        html += '</tbody></table>';
        const currentPage = response.currentPage || page;
        const totalPages = response.totalPages || 1;
        const pagination = `
                  <nav>
                      <ul class="pagination justify-content-center">
                          <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                              <button class="page-link" onclick="loadBorrowCapitals(${currentPage - 1}, ${pageSize}, '${userId}')">Previous</button>
                          </li>
                          <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                              <button class="page-link" onclick="loadBorrowCapitals(${currentPage + 1}, ${pageSize}, '${userId}')">Next</button>
                          </li>
                      </ul>
                  </nav>
              `;
        $('#BorrowCapitalTable').html(html);
        $('#pagination').html(pagination);
      },
      error: function(xhr, status, error) {
        console.error('Error:', status, error);
        hideLoading();
        $('#BorrowCapitalTable').html('<div class="text-center">Error loading data</div>');
        $('#pagination').html('');
      }
    });
  }

  function deleteBorrowCapital(id) {
    if (confirm('Are you sure you want to delete this BorrowCapital?')) {
      $.ajax({
        url: `/api/borrow-capital/${id}`,
        method: 'DELETE',
        success: function(response) {
          // Remove the row from the table on successful deletion
          $(`#BorrowCapital-row-${id}`).remove();
          console.log(`BorrowCapital with ID ${id} deleted successfully`);
          // Optional: Check if table is empty and reload if necessary
          if ($('#BorrowCapitalTable tbody tr').length === 0) {
            loadBorrowCapitals(1, 10, id); // Reload the table if no rows remain
          }
        },
        error: function(xhr, status, error) {
          console.error('Error:', status, error);
          $('#errorAlert').text('Error deleting BorrowCapital: ' + (xhr.responseJSON?.message || 'Unknown error')).show();
          setTimeout(() => $('#errorAlert').hide(), 5000); // Hide alert after 5 seconds
        }
      });
    }
  }

  function detailBorrowCapital(id) {
    localStorage.setItem("BorrowCapital", JSON.stringify({
      id: id,
    }));
    window.location.href = "/BorrowCapital/detail";
  }

  function showLoading() {
    $('#BorrowCapitalTable').html('<div class="text-center">Loading...</div>');
  }

  function hideLoading() {
    // No need to do anything here since the table replaces the loading message
  }

  function successLoading() {
    console.log('Operation successful');
  }

  $(document).ready(function() {
    loadBorrowCapitals(1, 10, id);
  });
</script>
}
