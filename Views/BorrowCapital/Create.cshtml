@using Microsoft.AspNetCore.Mvc
@{
    ViewData["Title"] = "List of Borrow Capital";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
  <h2 class="mb-4">Nhập Thông Tin Khoản Vay</h2>
  <form id="borrowCapitalForm">
    <div class="mb-3">
      <label class="form-label">Số Tiền Vay</label>
      <input type="number" class="form-control" name="LoanAmount" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Lương Tháng</label>
      <input type="number" class="form-control" name="Salaly" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Tỷ Lệ Lương (%)</label>
      <input type="number" step="0.01" class="form-control" name="PercentageSalary" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Số Kỳ Thanh Toán</label>
      <input type="number" class="form-control" name="NumberOfPayments" value="1" required />
    </div>

    <div class="mb-3">
      <label class="form-label">Ngày Vay</label>
      <input type="date" class="form-control" name="LoanDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Lý do vay </label>
      <input type="text" class="form-control" name ="LoanPurpose" value="" required/>
    </div>
    <button type="submit" class="btn btn-primary">Gửi</button>
  </form>

  <div id="result" class="mt-3" style="display:none;">
    <h4>Kết Quả Tính Toán</h4>
    <p><strong>Tổng Số Tiền Phải Trả:</strong> <span id="totalAmount"></span></p>
    <p><strong>Phần trăm Lãi:</strong> <span id="totalInterest"></span></p>
    <p><strong>Số Tiền Trả Hàng Tháng:</strong> <span id="monthlyAmount"></span></p>
    <p><strong>Có Thể Trả Được:</strong> <span id="boolMonthlyAmount"></span></p>
    <p><strong>Ngày Đến Hạn:</strong> <span id="dueDate"></span></p>
  </div>
</div>
@section Scripts {
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
  <script>
    $(document).ready(function () {
        // Hàm lấy dữ liệu từ form
        function getFormData() {
            return {
                LoanPurpose: $('input[name = "LoanPurpose"]').val(),
                LoanAmount: parseFloat($('input[name="LoanAmount"]').val()) || 0,
                Salaly: parseFloat($('input[name="Salaly"]').val()) || 0,
                PercentageSalary: parseFloat($('input[name="PercentageSalary"]').val()) || 0,
                NumberOfPayments: parseInt($('input[name="NumberOfPayments"]').val()) || 1,
                LoanDate: $('input[name="LoanDate"]').val() || new Date().toISOString().split('T')[0]
            };
        }

        // Hàm gọi API tính toán
        function calculateBorrowCapital(data, callback) {
            console.log('Calling /api/borrow-capital/calculate with data:', data);
            $.ajax({
                url: '/api/borrow-capital/calculate',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    console.log('API calculate success:', response);
                    $('#result').show();
                    $('#totalAmount').text(response.totalAmount);
                    $('#totalInterest').text(response.totalInterest);
                    $('#monthlyAmount').text(response.monthlyAmount);
                    $('#boolMonthlyAmount').text(response.boolMonthlyAmount ? "Có" : "Không");
                    $('#dueDate').text(new Date(response.dueDate).toLocaleDateString());
                    if (callback) callback(response); // Trả kết quả về nếu có callback
                },
                error: function (xhr) {
                    console.error('API calculate error:', xhr.responseJSON?.message || xhr.statusText);
                    $('#result').hide();
                }
            });
        }

        // Gọi tính toán realtime khi người dùng nhập liệu
        $('input[name="LoanAmount"], input[name="Salaly"], input[name="PercentageSalary"], input[name="NumberOfPayments"], input[name="LoanDate"]').on('input', function () {
            const formData = getFormData();
            console.log('Form data on input:', formData);
            if (formData.LoanAmount > 0 && formData.Salaly > 0 && formData.PercentageSalary > 0 && formData.NumberOfPayments > 0 && formData.NumberOfPayments <= 300) {
                calculateBorrowCapital(formData); // Chỉ hiển thị kết quả, không lưu
            } else if (formData.NumberOfPayments > 300) {
                alert("Số lần thanh toán phải nhỏ hơn hoặc bằng 300");
                $('#result').hide();
            } else {
                $('#result').hide();
                console.log('Invalid data, hiding result');
            }
        });

        // Xử lý submit form: Tính toán và lưu kết quả
        $('#borrowCapitalForm').on('submit', function (e) {
            e.preventDefault();
            const formData = getFormData();

            if (formData.LoanAmount <= 0 || formData.Salaly <= 0 || formData.PercentageSalary <= 0 || formData.NumberOfPayments <= 0 || formData.NumberOfPayments > 300) {
                alert("Vui lòng nhập đầy đủ và hợp lệ các thông tin!");
                return;
            }

            // Gọi API tính toán trước, sau đó dùng kết quả để gửi lên API lưu
            calculateBorrowCapital(formData, function (calculationResult) {
                const borrowCapitalData = {
                    UserId: @ViewData["UserId"] ?? 0, // Giả sử UserId lấy từ ViewData
                    LoanAmount: formData.LoanAmount,
                    LoanDate: formData.LoanDate,
                    LoanPurpose : formData.LoanPurpose,
                    DueDate: calculationResult.dueDate, // Lấy từ kết quả tính toán
                    RepaymentAmount: calculationResult.totalAmount, // Tổng số tiền phải trả
                    InterestRate: calculationResult.totalInterest, // Phần trăm lãi
                };

                console.log('Submitting to /api/borrow-capital with data:', borrowCapitalData);

                $.ajax({
                    url: '/api/borrow-capital',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(borrowCapitalData),
                    success: function (response) {
                        console.log('API create success:', response);
                        alert('Tạo khoản vay thành công!');
                        setTimeout(() => {
                            window.location.href = "/BorrowCapital/Index";
                        }, 2000);
                    },
                    error: function (xhr) {
                        console.error('API create error:', xhr.responseJSON?.message || xhr.statusText);
                        alert('Lỗi khi tạo khoản vay: ' + (xhr.responseJSON?.message || 'Không rõ lỗi'));
                    }
                });
            });
        });

        // Hàm hỗ trợ thêm tháng
        Date.prototype.addMonths = function (months) {
            const date = new Date(this);
            date.setMonth(date.getMonth() + months);
            return date;
        };
    });
  </script>
}
